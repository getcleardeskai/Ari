# Copy this file to .env and fill in real values. NEVER commit .env — it's
# already covered by the repo's .gitignore, keep it that way.

# ---- Safety switches — read bot/README.md before touching these ----------
# When true, the bot logs what it WOULD do and never calls Tradovate's
# order-placement endpoint. Keep this true until you've verified the
# webhook payloads look correct in the logs.
DRY_RUN=true
# "demo" (paper/simulated) or "live" (real money). Always prove this out on
# demo first.
TRADOVATE_ENV=demo

# ---- Webhook auth ----------------------------------------------------------
# Must exactly match the "Webhook secret" input on each Pine strategy.
# Make this a long random string, not a real word.
WEBHOOK_SECRET=changeme

# ---- Order sizing -----------------------------------------------------------
DEFAULT_QTY=1

# ---- Tradovate API credentials ---------------------------------------------
# From your Tradovate login + an API application you register at
# https://trader.tradovate.com (Settings -> API Access). appId/cid/sec come
# from the registered app; deviceId can be any stable string you choose
# (Tradovate uses it to identify this specific bot/client).
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_DEVICE_ID=ari-trading-bot
TRADOVATE_CID=
TRADOVATE_SEC=
# Optional — only needed if your login has more than one Tradovate account
# and the bot should use a specific one rather than the first one found.
TRADOVATE_ACCOUNT_ID=
