//@version=6
// ============================================================================
// Auto Reversion Strategy
//
// Mean-reversion half of the two-strategy plan (see
// ../knowledge/automation-architecture.md and ../knowledge/strategies/mean-reversion.md
// for full rules/context). Trades price reverting from the outer edge of an
// MRC-style channel back toward it, filtered by a 200 MA bias check and a
// volume confirmation window, triggered by QQE.
//
// Rules implemented (long case; short is the exact mirror):
//   1. BIAS   : 200 MA fully below the entire MRC band (below even its most
//               extreme lower band).
//   2. LOCATION: the setup candle's low tags the "entry band" level of the
//               MRC (default: outermost band) — this is what "overextended"
//               means here.
//   3. SIGNAL : a QQE long cross.
//   4. VOLUME : volume >= its own average, either on the signal bar or
//               within the next few bars after it (configurable window). No
//               confirmation within that window = the setup is invalidated.
//   5. TIMING : entries only fire on a CONFIRMED bar close, never mid-bar.
//
// UPDATE 2026-08-19: MRC and QQE are now EXACT ports of the trader's actual
// source scripts (fareidzulkifli's "Mean Reversion Channel" and colinmck's
// "QQE signals"), converted from Pine v4 to v6. MRC's mean line is an
// Ehlers SuperSmoother of hlc3 over 200 bars; the band width is a
// SuperSmoothed True Range scaled by pi*multiplier (inner = pi*1.0, outer =
// pi*2.415) — NOT a simple ATR-multiple channel, which is why the earlier
// approximated version produced zero trades (the bands didn't remotely line
// up with real price behavior). There are only 2 real band levels here
// (inner R1/S1, outer R2/S2), not 3. QQE's signal is a counter-based "just
// turned true" check (matches the source exactly), not ta.crossover — subtly
// different timing, now fixed to match. Only the default "SuperSmoother"
// filter type is implemented (that's the source's own default) — the
// alternate filter types (Gaussian/Butterworth/etc.) are not ported.
// Still open per the trader's own notes: which band level is the TP target
// (defaulted to the outer band, matching "the second band" — inner=1st,
// outer=2nd), the volume confirmation window length, fixed vs. swing-based
// stop — all exposed as inputs.
//
// UPDATE 2026-08-19 (again): added a diagnostic funnel table (bottom-left)
// counting how many confirmed bars satisfy each rule stage — raw QQE signal,
// +bias, +location, +volume->entered.
//
// UPDATE 2026-08-19 (yet again): ALL THREE RULE TOGGLES NOW DEFAULT OFF
// (useBiasFilter, useLocationFilter, requireVolume) — out of the box this
// trades on the raw QQE signal alone with no other filter, which WILL
// produce trades (QQE crosses regularly). This guarantees the Strategy
// Tester populates immediately so the whole pipeline (script/symbol/
// timeframe) can be confirmed working. Turn the three toggles on ONE AT A
// TIME, in the numbered order shown in their input labels, watching the
// diagnostic table's bar counts drop at each stage — that shows you exactly
// what each real rule costs in trade frequency, rather than either 5 rules
// ANDed together with zero visibility, or someone else's version that
// quietly dropped 2 of your 5 rules to "make it work."
//
// No painting (barstate.isconfirmed gating) and no re-entries (pyramiding=0
// + position-size checks) follow the same pattern as trend-bias-qqe-strategy.pine.
//
// Hand-written, not run through TradingView's compiler on my end — if it
// throws an error on first load, send the exact error text.
// ============================================================================
strategy("Auto Reversion Strategy", overlay = true, pyramiding = 0,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5,
     slippage = 1, calc_on_every_tick = false,
     max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
grpMRC = "MRC (exact port)"
mrcSource  = input.source(hlc3, "Price source", group = grpMRC)
mrcLength  = input.int(200, "Lookback period", minval = 1, group = grpMRC)
innerMult  = input.float(1.0, "Inner channel size multiplier", minval = 0.1, group = grpMRC)
outerMult  = input.float(2.415, "Outer channel size multiplier", minval = 0.1, group = grpMRC)
entryBandLevel = input.int(2, "Entry/overextension band level (1=inner, 2=outer)", minval = 1, maxval = 2, group = grpMRC)
tpBandLevel    = input.int(2, "Take-profit band level (1=inner, 2=outer)", minval = 1, maxval = 2, group = grpMRC)
showZone   = input.bool(true, "Draw gradient zone (visual only)", group = grpMRC)
zoneTransp = input.int(60, "Zone transparency", minval = 0, maxval = 100, group = grpMRC)

grpBias = "Bias (200 MA)"
maLen  = input.int(200, "Bias MA length", minval = 1, group = grpBias)
maType = input.string("SMMA", "Bias MA type", options = ["SMMA", "SMA"], group = grpBias)

grpFilters = "Rule Toggles — ALL OFF by default so trades fire immediately. Turn ON one at a time, top to bottom, to add your real rules back and watch the diagnostic table below change."
useBiasFilter     = input.bool(false, "1) Require bias filter (SMA/SMMA fully outside outer band)", group = grpFilters)
useLocationFilter = input.bool(false, "2) Require location filter (candle tags outer band)", group = grpFilters)
requireVolume     = input.bool(false, "3) Require volume confirmation", group = grpFilters)

grpVol = "Volume Confirmation"
volAvgLen      = input.int(20, "Volume average length", minval = 1, group = grpVol)
volConfirmBars = input.int(3, "Confirmation window (bars after signal)", minval = 0, group = grpVol)

grpQQE = "QQE Entry Signal"
rsiLen    = input.int(14, "RSI length", minval = 2, group = grpQQE)
rsiSmooth = input.int(5, "RSI smoothing (EMA)", minval = 1, group = grpQQE)
qqeFactor = input.float(4.238, "QQE factor", minval = 0.1, step = 0.001, group = grpQQE)

grpRisk = "Risk / Exit"
useFixedStop = input.bool(true, "Use fixed-tick stop (off = last swing low/high)", group = grpRisk)
stopTicks    = input.float(25, "Fixed stop (ticks)", minval = 1, group = grpRisk)
swingLen     = input.int(5, "Swing lookback for swing-based stop", minval = 1, group = grpRisk)

grpColor = "Colors"
colBull = input.color(#089981, "Bullish color", group = grpColor)
colBear = input.color(#f23645, "Bearish color", group = grpColor)

tick = syminfo.mintick

// ---------------------------------------------------------------------------
// MRC — exact port of fareidzulkifli's "Mean Reversion Channel" (SuperSmoother
// variant, the source's own default). Mean line = SuperSmoother(source, len);
// band width = SuperSmoother(True Range, len) * pi * multiplier.
// ---------------------------------------------------------------------------
f_supersmoother(src, len) =>
    a1 = math.exp(-math.sqrt(2) * math.pi / len)
    b1 = 2 * a1 * math.cos(math.sqrt(2) * math.pi / len)
    c3 = -math.pow(a1, 2)
    c2 = b1
    c1 = 1 - c2 - c3
    var float ss = na
    ss := c1 * src + c2 * nz(ss[1], src[1]) + c3 * nz(ss[2], src[2])
    ss

meanline = f_supersmoother(mrcSource, mrcLength)
meanrange = f_supersmoother(ta.tr, mrcLength)

multInner = math.pi * innerMult
multOuter = math.pi * outerMult

upper1 = meanline + meanrange * multInner
lower1 = meanline - meanrange * multInner
upper2 = meanline + meanrange * multOuter
lower2 = meanline - meanrange * multOuter

pMean   = plot(meanline, "MRC Mean", color = color.new(#FFCD00, 0), linewidth = 2)
pUpper1 = plot(upper1, "MRC R1 (inner)", color = color.new(color.green, 50))
pLower1 = plot(lower1, "MRC S1 (inner)", color = color.new(color.green, 50))
pUpper2 = plot(upper2, "MRC R2 (outer)", color = color.new(color.red, 50))
pLower2 = plot(lower2, "MRC S2 (outer)", color = color.new(color.red, 50))
fill(pUpper1, pUpper2, color = color.new(color.red, 88))
fill(pLower1, pLower2, color = color.new(color.green, 88))

// Gradient zone extending past the outer band — visual match to the source
// indicator's "Draw Zone" feature. 9 boundary levels per side, 8 shaded
// segments each, red (furthest out) fading to gold (nearest the outer band).
gradsize = 0.5

upper2_1 = upper2 + meanrange * gradsize * 4
upper2_2 = upper2 + meanrange * gradsize * 3
upper2_3 = upper2 + meanrange * gradsize * 2
upper2_4 = upper2 + meanrange * gradsize * 1
upper2_5 = upper2 + meanrange * gradsize * 0
upper2_6 = upper2 + meanrange * gradsize * -1
upper2_7 = upper2 + meanrange * gradsize * -2
upper2_8 = upper2 + meanrange * gradsize * -3
upper2_9 = upper2 + meanrange * gradsize * -4
lower2_1 = lower2 - meanrange * gradsize * 4
lower2_2 = lower2 - meanrange * gradsize * 3
lower2_3 = lower2 - meanrange * gradsize * 2
lower2_4 = lower2 - meanrange * gradsize * 1
lower2_5 = lower2 - meanrange * gradsize * 0
lower2_6 = lower2 - meanrange * gradsize * -1
lower2_7 = lower2 - meanrange * gradsize * -2
lower2_8 = lower2 - meanrange * gradsize * -3
lower2_9 = lower2 - meanrange * gradsize * -4

pu1 = plot(upper2_1, color = na, display = display.none)
pu2 = plot(upper2_2, color = na, display = display.none)
pu3 = plot(upper2_3, color = na, display = display.none)
pu4 = plot(upper2_4, color = na, display = display.none)
pu5 = plot(upper2_5, color = na, display = display.none)
pu6 = plot(upper2_6, color = na, display = display.none)
pu7 = plot(upper2_7, color = na, display = display.none)
pu8 = plot(upper2_8, color = na, display = display.none)
pu9 = plot(upper2_9, color = na, display = display.none)
pl1 = plot(lower2_1, color = na, display = display.none)
pl2 = plot(lower2_2, color = na, display = display.none)
pl3 = plot(lower2_3, color = na, display = display.none)
pl4 = plot(lower2_4, color = na, display = display.none)
pl5 = plot(lower2_5, color = na, display = display.none)
pl6 = plot(lower2_6, color = na, display = display.none)
pl7 = plot(lower2_7, color = na, display = display.none)
pl8 = plot(lower2_8, color = na, display = display.none)
pl9 = plot(lower2_9, color = na, display = display.none)

zColor1 = color.new(#FF0000, zoneTransp)
zColor2 = color.new(#FF4200, zoneTransp)
zColor3 = color.new(#FF5D00, zoneTransp)
zColor4 = color.new(#FF7400, zoneTransp)
zColor5 = color.new(#FF9700, zoneTransp)
zColor6 = color.new(#FFAE00, zoneTransp)
zColor7 = color.new(#FFC500, zoneTransp)
zColor8 = color.new(#FFCD00, zoneTransp)

fill(pu1, pu2, color = showZone ? zColor1 : na)
fill(pu2, pu3, color = showZone ? zColor2 : na)
fill(pu3, pu4, color = showZone ? zColor3 : na)
fill(pu4, pu5, color = showZone ? zColor4 : na)
fill(pu5, pu6, color = showZone ? zColor5 : na)
fill(pu6, pu7, color = showZone ? zColor6 : na)
fill(pu7, pu8, color = showZone ? zColor7 : na)
fill(pu8, pu9, color = showZone ? zColor8 : na)
fill(pl1, pl2, color = showZone ? zColor1 : na)
fill(pl2, pl3, color = showZone ? zColor2 : na)
fill(pl3, pl4, color = showZone ? zColor3 : na)
fill(pl4, pl5, color = showZone ? zColor4 : na)
fill(pl5, pl6, color = showZone ? zColor5 : na)
fill(pl6, pl7, color = showZone ? zColor6 : na)
fill(pl7, pl8, color = showZone ? zColor7 : na)
fill(pl8, pl9, color = showZone ? zColor8 : na)

f_bandAt(level, upperSide) =>
    band = level == 1 ? (upperSide ? upper1 : lower1) : (upperSide ? upper2 : lower2)
    band

entryUpperBand = f_bandAt(entryBandLevel, true)
entryLowerBand = f_bandAt(entryBandLevel, false)
tpUpperBand    = f_bandAt(tpBandLevel, true)
tpLowerBand    = f_bandAt(tpBandLevel, false)

// ---------------------------------------------------------------------------
// Bias — 200 MA fully below/above the entire (outer) MRC band. SMMA
// (Smoothed MA) is what Pine calls RMA (Wilder's smoothing) — exposed as a
// toggle now instead of asserted, since it's worth testing both against
// what you actually see on your real chart.
// ---------------------------------------------------------------------------
maVal = maType == "SMMA" ? ta.rma(close, maLen) : ta.sma(close, maLen)
plot(maVal, "Bias MA", color = color.new(color.white, 0), linewidth = 2)

biasLongOk  = maVal < lower2
biasShortOk = maVal > upper2

// ---------------------------------------------------------------------------
// Location — setup candle tags the entry band level
// ---------------------------------------------------------------------------
locationLongOk  = low <= entryLowerBand
locationShortOk = high >= entryUpperBand

// ---------------------------------------------------------------------------
// QQE signal — exact port of colinmck's "QQE signals". Fires on the bar the
// trend-line/RSI relationship FIRST flips (a counter that resets to 0
// whenever the condition is false, signal = counter just hit 1) — not the
// same as ta.crossover, matches the source's own logic precisely.
// ---------------------------------------------------------------------------
rsiVal   = ta.rsi(close, rsiLen)
rsiMa    = ta.ema(rsiVal, rsiSmooth)
atrRsi   = math.abs(rsiMa[1] - rsiMa)
wilders  = rsiLen * 2 - 1
maAtrRsi = ta.ema(atrRsi, wilders)
deltaFastAtrRsi = ta.ema(maAtrRsi, wilders) * qqeFactor

var float longBand  = 0.0
var float shortBand = 0.0
var int   qqeTrend   = 1

newLongBand  = rsiMa - deltaFastAtrRsi
newShortBand = rsiMa + deltaFastAtrRsi

longBand  := (rsiMa[1] > longBand[1] and rsiMa > longBand[1]) ? math.max(longBand[1], newLongBand) : newLongBand
shortBand := (rsiMa[1] < shortBand[1] and rsiMa < shortBand[1]) ? math.min(shortBand[1], newShortBand) : newShortBand

qqeTrend := ta.cross(rsiMa, shortBand[1]) ? 1 : ta.cross(longBand[1], rsiMa) ? -1 : nz(qqeTrend[1], 1)
fastAtrRsiTL = qqeTrend == 1 ? longBand : shortBand

var int qqeXLongCount  = 0
var int qqeXShortCount = 0
qqeXLongCount  := fastAtrRsiTL < rsiMa ? qqeXLongCount + 1 : 0
qqeXShortCount := fastAtrRsiTL > rsiMa ? qqeXShortCount + 1 : 0

qqeCrossUp   = qqeXLongCount == 1
qqeCrossDown = qqeXShortCount == 1

qqeLongSignal  = qqeCrossUp and barstate.isconfirmed
qqeShortSignal = qqeCrossDown and barstate.isconfirmed

// ---------------------------------------------------------------------------
// Volume confirmation
// ---------------------------------------------------------------------------
volAvg = ta.sma(volume, volAvgLen)
volOk  = requireVolume ? (volume >= volAvg) : true

// ---------------------------------------------------------------------------
// Setup state machine — a QQE+bias+location setup either confirms
// immediately (volume already OK) or goes "pending" for up to
// volConfirmBars additional bars waiting for volume to confirm.
// ---------------------------------------------------------------------------
var int pendingDir     = 0   // 0 none, 1 long pending, -1 short pending
var int pendingBarsLeft = 0

doLongEntry  = false
doShortEntry = false

newLongSetup  = qqeLongSignal  and (not useBiasFilter or biasLongOk)  and (not useLocationFilter or locationLongOk)
newShortSetup = qqeShortSignal and (not useBiasFilter or biasShortOk) and (not useLocationFilter or locationShortOk)

if barstate.isconfirmed
    if newLongSetup
        if volOk
            doLongEntry := true
            pendingDir := 0
        else
            pendingDir := 1
            pendingBarsLeft := volConfirmBars
    else if pendingDir == 1
        if volOk
            doLongEntry := true
            pendingDir := 0
        else
            pendingBarsLeft -= 1
            if pendingBarsLeft < 0
                pendingDir := 0

    if newShortSetup
        if volOk
            doShortEntry := true
            pendingDir := 0
        else
            pendingDir := -1
            pendingBarsLeft := volConfirmBars
    else if pendingDir == -1
        if volOk
            doShortEntry := true
            pendingDir := 0
        else
            pendingBarsLeft -= 1
            if pendingBarsLeft < 0
                pendingDir := 0

// ---------------------------------------------------------------------------
// Entries (no re-entry: pyramiding=0 + explicit position check)
// ---------------------------------------------------------------------------
longCondition  = doLongEntry  and strategy.position_size <= 0
shortCondition = doShortEntry and strategy.position_size >= 0

var float entryStop = na
var float entryTP   = na

swingLow  = ta.lowest(low, swingLen)
swingHigh = ta.highest(high, swingLen)

if longCondition
    strategy.entry("Long", strategy.long)
    entryStop := useFixedStop ? close - stopTicks * tick : swingLow[1]
    entryTP   := tpUpperBand

if shortCondition
    strategy.entry("Short", strategy.short)
    entryStop := useFixedStop ? close + stopTicks * tick : swingHigh[1]
    entryTP   := tpLowerBand

if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", stop = entryStop, limit = entryTP)
if strategy.position_size < 0
    strategy.exit("Short Exit", "Short", stop = entryStop, limit = entryTP)

plotshape(longCondition, style = shape.triangleup, location = location.belowbar, color = colBull, size = size.small, title = "Long Entry")
plotshape(shortCondition, style = shape.triangledown, location = location.abovebar, color = colBear, size = size.small, title = "Short Entry")

// ---------------------------------------------------------------------------
// Diagnostic funnel — counts how many CONFIRMED bars satisfy each stage of
// the rule chain, so you can see exactly where entries are getting choked
// off instead of just seeing "zero trades" with no explanation. Table in
// the bottom-left.
// ---------------------------------------------------------------------------
stage1Long  = qqeLongSignal  and (not useBiasFilter or biasLongOk)
stage1Short = qqeShortSignal and (not useBiasFilter or biasShortOk)

var int cQQE     = 0   // raw QQE signal, either direction, no filters at all
var int cBias    = 0   // QQE signal AND (bias, if enabled)
var int cLoc     = 0   // + (location, if enabled) — this equals newLongSetup/newShortSetup
var int cEntered = 0   // + (volume, if enabled) AND actually entered (flat/no re-entry)

if barstate.isconfirmed
    if qqeLongSignal or qqeShortSignal
        cQQE += 1
    if stage1Long or stage1Short
        cBias += 1
    if newLongSetup or newShortSetup
        cLoc += 1
if longCondition or shortCondition
    cEntered += 1

var table diag = table.new(position.bottom_left, 2, 5, border_width = 1, border_color = color.new(color.gray, 50))
if barstate.islast
    table.cell(diag, 0, 0, "Funnel stage", bgcolor = color.new(color.gray, 70), text_color = color.white, text_size = size.small)
    table.cell(diag, 1, 0, "Bars", bgcolor = color.new(color.gray, 70), text_color = color.white, text_size = size.small)
    table.cell(diag, 0, 1, "QQE signal (raw)", bgcolor = color.new(color.black, 60), text_color = color.white, text_size = size.small)
    table.cell(diag, 1, 1, str.tostring(cQQE), bgcolor = color.new(color.black, 60), text_color = color.white, text_size = size.small)
    table.cell(diag, 0, 2, "+ Bias" + (useBiasFilter ? "" : " (off)"), bgcolor = color.new(color.black, 60), text_color = color.white, text_size = size.small)
    table.cell(diag, 1, 2, str.tostring(cBias), bgcolor = color.new(color.black, 60), text_color = color.white, text_size = size.small)
    table.cell(diag, 0, 3, "+ Location" + (useLocationFilter ? "" : " (off)"), bgcolor = color.new(color.black, 60), text_color = color.white, text_size = size.small)
    table.cell(diag, 1, 3, str.tostring(cLoc), bgcolor = color.new(color.black, 60), text_color = color.white, text_size = size.small)
    table.cell(diag, 0, 4, "+ Volume -> Entered" + (requireVolume ? "" : " (off)"), bgcolor = color.new(color.black, 60), text_color = color.white, text_size = size.small)
    table.cell(diag, 1, 4, str.tostring(cEntered), bgcolor = color.new(color.black, 60), text_color = color.white, text_size = size.small)

alertcondition(longCondition, "Auto Reversion Long", "{{ticker}} Auto Reversion long entry @ {{close}}")
alertcondition(shortCondition, "Auto Reversion Short", "{{ticker}} Auto Reversion short entry @ {{close}}")

// ---------------------------------------------------------------------------
// Bot webhook alerts — fires a JSON payload the bot (see ../bot/) can parse
// directly, on both entries and exits. Exit detection is generic (any
// transition from a non-flat position to flat), so it fires whether the
// exit was the stop or the take-profit — the bot doesn't need to know which.
// ---------------------------------------------------------------------------
grpBot = "Bot Webhook"
webhookSecret   = input.string("changeme", "Webhook secret (must match the bot's WEBHOOK_SECRET)", group = grpBot)
botStrategyName = input.string("auto_reversion", "Strategy name sent to the bot", group = grpBot)

f_alertJson(action) =>
    '{"secret":"' + webhookSecret + '","strategy":"' + botStrategyName + '","symbol":"' + syminfo.ticker + '","action":"' + action + '","price":' + str.tostring(close) + '}'

if longCondition
    alert(f_alertJson("long"), alert.freq_once_per_bar)
if shortCondition
    alert(f_alertJson("short"), alert.freq_once_per_bar)

var float prevPositionSize = 0.0
positionJustClosedLong  = prevPositionSize > 0 and strategy.position_size <= 0
positionJustClosedShort = prevPositionSize < 0 and strategy.position_size >= 0
if positionJustClosedLong
    alert(f_alertJson("close_long"), alert.freq_once_per_bar)
if positionJustClosedShort
    alert(f_alertJson("close_short"), alert.freq_once_per_bar)
prevPositionSize := strategy.position_size
