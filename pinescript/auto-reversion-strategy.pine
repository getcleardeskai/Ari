//@version=6
// ============================================================================
// Auto Reversion Strategy — v1 (simple, long + short)
//
// Mean-reversion half of the two-strategy plan (see
// ../knowledge/automation-architecture.md and ../knowledge/strategies/mean-reversion.md).
//
// Rules, exactly as specified 2026-08-19 (long case; short is the exact mirror):
//   1. BIAS  : the entire MRC channel sits above the 200 MA (equivalently:
//              the MA is fully below the outer band). Mirror: entire MRC
//              below the MA, for shorts.
//   2. TOUCH : price has touched the outer band at some point while that
//              bias holds. Persistent, not same-bar — the touch and the
//              signal do NOT need to happen on the same candle.
//   3. SIGNAL: once touched, wait (however long it takes) for a QQE
//              long/short signal. It does not need to print while price is
//              still inside/touching the band — only that a touch happened
//              at some point since bias last became true.
//   4. TIMING: entries only fire on a CONFIRMED bar close.
//   5. No volume filter for this version — can be added back once this
//      simple version is validated.
//
// Exit: take profit when price touches the INNER band on the opposite side
// (R1 for longs, S1 for shorts) — a continuously-updated limit order at the
// live level, not frozen at entry. Stop loss is at the OUTER band on the
// entry side — the bottom of the lower (S2) band for longs, the top of the
// upper (R2) band for shorts — also live-updated each bar.
//
// MRC is an exact port of fareidzulkifli's "Mean Reversion Channel"
// (SuperSmoother variant): mean line = SuperSmoother(hlc3, 200); band width
// = SuperSmoother(True Range, 200) * pi * multiplier. Outer multiplier
// defaults to 1.5 — confirmed directly from the trader's real MRC settings
// (not the public script's own default of 2.415). QQE is an exact port of
// colinmck's "QQE signals" (counter-based signal, not ta.crossover).
//
// No painting (barstate.isconfirmed gating) and no re-entries (pyramiding=0
// + position-size checks), same pattern as trend-bias-qqe-strategy.pine.
//
// Hand-written, not run through TradingView's compiler on my end — if it
// throws an error on first load, send the exact error text.
// ============================================================================
strategy("Auto Reversion Strategy", overlay = true, pyramiding = 0,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.5,
     slippage = 1, calc_on_every_tick = false,
     max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
grpMRC = "MRC (exact port)"
mrcSource = input.source(hlc3, "Price source", group = grpMRC)
mrcLength = input.int(200, "Lookback period", minval = 1, group = grpMRC)
innerMult = input.float(1.0, "Inner channel size multiplier", minval = 0.1, group = grpMRC)
outerMult = input.float(1.5, "Outer channel size multiplier", minval = 0.1, group = grpMRC)
showZone   = input.bool(true, "Draw gradient zone (visual only)", group = grpMRC)
zoneTransp = input.int(60, "Zone transparency", minval = 0, maxval = 100, group = grpMRC)

grpBias = "Bias (200 MA)"
maLen  = input.int(200, "Bias MA length", minval = 1, group = grpBias)
maType = input.string("SMMA", "Bias MA type", options = ["SMMA", "SMA"], group = grpBias)

grpQQE = "QQE Entry Signal"
rsiLen    = input.int(14, "RSI length", minval = 2, group = grpQQE)
rsiSmooth = input.int(5, "RSI smoothing (EMA)", minval = 1, group = grpQQE)
qqeFactor = input.float(4.238, "QQE factor", minval = 0.1, step = 0.001, group = grpQQE)

grpColor = "Colors"
colBull = input.color(#089981, "Bullish color", group = grpColor)
colBear = input.color(#f23645, "Bearish color", group = grpColor)

// ---------------------------------------------------------------------------
// MRC
// ---------------------------------------------------------------------------
f_supersmoother(src, len) =>
    a1 = math.exp(-math.sqrt(2) * math.pi / len)
    b1 = 2 * a1 * math.cos(math.sqrt(2) * math.pi / len)
    c3 = -math.pow(a1, 2)
    c2 = b1
    c1 = 1 - c2 - c3
    var float ss = na
    ss := c1 * src + c2 * nz(ss[1], src[1]) + c3 * nz(ss[2], src[2])
    ss

meanline  = f_supersmoother(mrcSource, mrcLength)
meanrange = f_supersmoother(ta.tr, mrcLength)

multInner = math.pi * innerMult
multOuter = math.pi * outerMult

upper1 = meanline + meanrange * multInner   // inner top band (R1) — exit target
lower1 = meanline - meanrange * multInner
upper2 = meanline + meanrange * multOuter   // outer band (R2/S2) — touch/bias boundary
lower2 = meanline - meanrange * multOuter

pMean   = plot(meanline, "MRC Mean", color = color.new(#FFCD00, 0), linewidth = 2)
pUpper1 = plot(upper1, "MRC R1 (inner)", color = color.new(color.green, 50))
pLower1 = plot(lower1, "MRC S1 (inner)", color = color.new(color.green, 50))
pUpper2 = plot(upper2, "MRC R2 (outer)", color = color.new(color.red, 50))
pLower2 = plot(lower2, "MRC S2 (outer)", color = color.new(color.red, 50))
fill(pUpper1, pUpper2, color = color.new(color.red, 88))
fill(pLower1, pLower2, color = color.new(color.green, 88))

// Gradient zone extending past the outer band — visual match to the source
// indicator's "Draw Zone" feature.
gradsize = 0.5

upper2_1 = upper2 + meanrange * gradsize * 4
upper2_2 = upper2 + meanrange * gradsize * 3
upper2_3 = upper2 + meanrange * gradsize * 2
upper2_4 = upper2 + meanrange * gradsize * 1
upper2_5 = upper2 + meanrange * gradsize * 0
upper2_6 = upper2 + meanrange * gradsize * -1
upper2_7 = upper2 + meanrange * gradsize * -2
upper2_8 = upper2 + meanrange * gradsize * -3
upper2_9 = upper2 + meanrange * gradsize * -4
lower2_1 = lower2 - meanrange * gradsize * 4
lower2_2 = lower2 - meanrange * gradsize * 3
lower2_3 = lower2 - meanrange * gradsize * 2
lower2_4 = lower2 - meanrange * gradsize * 1
lower2_5 = lower2 - meanrange * gradsize * 0
lower2_6 = lower2 - meanrange * gradsize * -1
lower2_7 = lower2 - meanrange * gradsize * -2
lower2_8 = lower2 - meanrange * gradsize * -3
lower2_9 = lower2 - meanrange * gradsize * -4

pu1 = plot(upper2_1, color = na, display = display.none)
pu2 = plot(upper2_2, color = na, display = display.none)
pu3 = plot(upper2_3, color = na, display = display.none)
pu4 = plot(upper2_4, color = na, display = display.none)
pu5 = plot(upper2_5, color = na, display = display.none)
pu6 = plot(upper2_6, color = na, display = display.none)
pu7 = plot(upper2_7, color = na, display = display.none)
pu8 = plot(upper2_8, color = na, display = display.none)
pu9 = plot(upper2_9, color = na, display = display.none)
pl1 = plot(lower2_1, color = na, display = display.none)
pl2 = plot(lower2_2, color = na, display = display.none)
pl3 = plot(lower2_3, color = na, display = display.none)
pl4 = plot(lower2_4, color = na, display = display.none)
pl5 = plot(lower2_5, color = na, display = display.none)
pl6 = plot(lower2_6, color = na, display = display.none)
pl7 = plot(lower2_7, color = na, display = display.none)
pl8 = plot(lower2_8, color = na, display = display.none)
pl9 = plot(lower2_9, color = na, display = display.none)

zColor1 = color.new(#FF0000, zoneTransp)
zColor2 = color.new(#FF4200, zoneTransp)
zColor3 = color.new(#FF5D00, zoneTransp)
zColor4 = color.new(#FF7400, zoneTransp)
zColor5 = color.new(#FF9700, zoneTransp)
zColor6 = color.new(#FFAE00, zoneTransp)
zColor7 = color.new(#FFC500, zoneTransp)
zColor8 = color.new(#FFCD00, zoneTransp)

fill(pu1, pu2, color = showZone ? zColor1 : na)
fill(pu2, pu3, color = showZone ? zColor2 : na)
fill(pu3, pu4, color = showZone ? zColor3 : na)
fill(pu4, pu5, color = showZone ? zColor4 : na)
fill(pu5, pu6, color = showZone ? zColor5 : na)
fill(pu6, pu7, color = showZone ? zColor6 : na)
fill(pu7, pu8, color = showZone ? zColor7 : na)
fill(pu8, pu9, color = showZone ? zColor8 : na)
fill(pl1, pl2, color = showZone ? zColor1 : na)
fill(pl2, pl3, color = showZone ? zColor2 : na)
fill(pl3, pl4, color = showZone ? zColor3 : na)
fill(pl4, pl5, color = showZone ? zColor4 : na)
fill(pl5, pl6, color = showZone ? zColor5 : na)
fill(pl6, pl7, color = showZone ? zColor6 : na)
fill(pl7, pl8, color = showZone ? zColor7 : na)
fill(pl8, pl9, color = showZone ? zColor8 : na)

// ---------------------------------------------------------------------------
// Bias — entire MRC above/below the 200 MA, i.e. the MA sits fully below the
// outer band (longs) or fully above it (shorts)
// ---------------------------------------------------------------------------
maVal = maType == "SMMA" ? ta.rma(close, maLen) : ta.sma(close, maLen)
plot(maVal, "Bias MA", color = color.new(color.white, 0), linewidth = 2)

biasLongOk  = maVal < lower2
biasShortOk = maVal > upper2

// ---------------------------------------------------------------------------
// QQE signal — exact port of colinmck's "QQE signals" (counter-based, not
// ta.crossover).
// ---------------------------------------------------------------------------
rsiVal   = ta.rsi(close, rsiLen)
rsiMa    = ta.ema(rsiVal, rsiSmooth)
atrRsi   = math.abs(rsiMa[1] - rsiMa)
wilders  = rsiLen * 2 - 1
maAtrRsi = ta.ema(atrRsi, wilders)
deltaFastAtrRsi = ta.ema(maAtrRsi, wilders) * qqeFactor

var float longBand  = 0.0
var float shortBand = 0.0
var int   qqeTrend   = 1

newLongBand  = rsiMa - deltaFastAtrRsi
newShortBand = rsiMa + deltaFastAtrRsi

longBand  := (rsiMa[1] > longBand[1] and rsiMa > longBand[1]) ? math.max(longBand[1], newLongBand) : newLongBand
shortBand := (rsiMa[1] < shortBand[1] and rsiMa < shortBand[1]) ? math.min(shortBand[1], newShortBand) : newShortBand

qqeTrend := ta.cross(rsiMa, shortBand[1]) ? 1 : ta.cross(longBand[1], rsiMa) ? -1 : nz(qqeTrend[1], 1)
fastAtrRsiTL = qqeTrend == 1 ? longBand : shortBand

var int qqeXLongCount  = 0
var int qqeXShortCount = 0
qqeXLongCount  := fastAtrRsiTL < rsiMa ? qqeXLongCount + 1 : 0
qqeXShortCount := fastAtrRsiTL > rsiMa ? qqeXShortCount + 1 : 0
qqeCrossUp   = qqeXLongCount == 1
qqeCrossDown = qqeXShortCount == 1

qqeLongSignal  = qqeCrossUp   and barstate.isconfirmed
qqeShortSignal = qqeCrossDown and barstate.isconfirmed

// ---------------------------------------------------------------------------
// Setup — persistent touch, not same-bar. While bias holds, remember that
// price has touched the outer band; once touched, take the next QQE
// long/short signal whenever it comes (same bar or many bars later). Reset
// if bias breaks before a signal arrives.
// ---------------------------------------------------------------------------
var bool touchedLower = false
var bool touchedUpper = false

if barstate.isconfirmed
    if not biasLongOk
        touchedLower := false
    else if low <= lower2
        touchedLower := true

    if not biasShortOk
        touchedUpper := false
    else if high >= upper2
        touchedUpper := true

doLongEntry  = false
doShortEntry = false
if barstate.isconfirmed and biasLongOk and touchedLower and qqeLongSignal
    doLongEntry := true
    touchedLower := false   // consumed
if barstate.isconfirmed and biasShortOk and touchedUpper and qqeShortSignal
    doShortEntry := true
    touchedUpper := false   // consumed

// ---------------------------------------------------------------------------
// Entries (no re-entry: pyramiding=0 + explicit position check)
// ---------------------------------------------------------------------------
longCondition  = doLongEntry  and strategy.position_size <= 0
shortCondition = doShortEntry and strategy.position_size >= 0

if longCondition
    strategy.entry("Long", strategy.long)
if shortCondition
    strategy.entry("Short", strategy.short)

// Stop and target are both LIVE — continuously updated each bar, not frozen
// at entry. Stop = outer band on the entry side (bottom of S2 for longs,
// top of R2 for shorts). Target = inner band on the opposite side (R1 for
// longs, S1 for shorts).
if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", stop = lower2, limit = upper1)
if strategy.position_size < 0
    strategy.exit("Short Exit", "Short", stop = upper2, limit = lower1)

plotshape(longCondition, style = shape.triangleup, location = location.belowbar, color = colBull, size = size.small, title = "Long Entry")
plotshape(shortCondition, style = shape.triangledown, location = location.abovebar, color = colBear, size = size.small, title = "Short Entry")

alertcondition(longCondition, "Auto Reversion Long", "{{ticker}} Auto Reversion long entry @ {{close}}")
alertcondition(shortCondition, "Auto Reversion Short", "{{ticker}} Auto Reversion short entry @ {{close}}")

// ---------------------------------------------------------------------------
// Bot webhook alerts — fires a JSON payload the bot (see ../bot/) can parse
// directly, on entry and on exit (any transition from long to flat, whether
// stop or take-profit).
// ---------------------------------------------------------------------------
grpBot = "Bot Webhook"
webhookSecret   = input.string("changeme", "Webhook secret (must match the bot's WEBHOOK_SECRET)", group = grpBot)
botStrategyName = input.string("auto_reversion", "Strategy name sent to the bot", group = grpBot)

f_alertJson(action) =>
    '{"secret":"' + webhookSecret + '","strategy":"' + botStrategyName + '","symbol":"' + syminfo.ticker + '","action":"' + action + '","price":' + str.tostring(close) + '}'

if longCondition
    alert(f_alertJson("long"), alert.freq_once_per_bar)
if shortCondition
    alert(f_alertJson("short"), alert.freq_once_per_bar)

var float prevPositionSize = 0.0
positionJustClosedLong  = prevPositionSize > 0 and strategy.position_size <= 0
positionJustClosedShort = prevPositionSize < 0 and strategy.position_size >= 0
if positionJustClosedLong
    alert(f_alertJson("close_long"), alert.freq_once_per_bar)
if positionJustClosedShort
    alert(f_alertJson("close_short"), alert.freq_once_per_bar)
prevPositionSize := strategy.position_size
