//@version=6
// ============================================================================
// MRC (In/Out Bands) + 200 SMMA + QQE
//
// MRC:
//   R1 / S1 = Inner channel
//   R2 / S2 = Outer channel
//
// 200 SMMA:
//   Completely independent of MRC
//   Uses ta.rma(close, 200)
//   WHITE = SMMA inside MRC
//   LIGHT BLUE = SMMA outside outer MRC
//
// QQE:
//   Long  = SMMA below S2 + price reaches lower gap
//   Short = SMMA above R2 + price reaches upper gap
//
//   2026-08-20 FIX: the gap touch and the QQE cross used to have to land on
//   the SAME bar (`gapLongOk`/`gapShortOk` only looked at that bar's
//   high/low). QQE is an RSI-smoothed, ATR-trailing-band signal — it's
//   inherently laggy, so its counter often doesn't hit 1 until a few bars
//   AFTER price already wicked into the gap and started pulling back. By
//   the signal bar, price is usually back inside the zone, so the same-bar
//   check silently failed even on genuinely valid setups — missed trades,
//   not a filter working as intended. Fixed with `longArmed`/`shortArmed`:
//   a touch that happens while the bias (SMMA side) already holds stays
//   "armed" across however many bars it takes for the QQE signal to
//   actually print, clearing only when the bias itself breaks (SMMA back
//   inside/flipped) or the signal consumes it.
//
// TP:
//   LONG  -> R1 / Upper Inner Band
//   SHORT -> S1 / Lower Inner Band
//   TP follows the inner band dynamically.
//
// SL:
//   Fixed N ticks from entry (input, default 100).
//   No MRC-distance/buffer logic.
//
// TPT SESSION LOGIC:
//   Trades are allowed during the full futures trading session,
//   including overnight / Asia.
//
//   New trades are blocked during the final 20 minutes before
//   the TPT 5:00 PM ET flat deadline.
//
//   Any active tracked trade is cleared at 5:00 PM ET so it
//   cannot be carried through the TPT cutoff.
//
// ============================================================================

indicator(
     "MRC (In/Out Bands) + 200 SMMA + QQE",
     overlay = true,
     max_lines_count = 500)


// ============================================================================
// MRC INPUTS
// ============================================================================

grpMRC = "MRC"

mrcSource = input.source(
     hlc3,
     "Price source",
     group = grpMRC)

mrcLength = input.int(
     200,
     "Lookback period",
     minval = 1,
     group = grpMRC)

innerMult = input.float(
     1.0,
     "Inner channel size multiplier",
     minval = 0.1,
     group = grpMRC)

outerMult = input.float(
     2.415,
     "Outer channel size multiplier",
     minval = 0.1,
     group = grpMRC)

showMean = input.bool(
     false,
     "Show MRC mean line",
     group = grpMRC)

showFill = input.bool(
     true,
     "Shade between inner and outer bands",
     group = grpMRC)


// ============================================================================
// 200 SMMA SETTINGS
// ============================================================================

grpMA = "200 SMMA"

maLen = input.int(
     200,
     "SMMA length",
     minval = 1,
     group = grpMA)

showMA = input.bool(
     true,
     "Show 200 SMMA",
     group = grpMA)


// ============================================================================
// COLOR SETTINGS
// ============================================================================

grpColor = "Colors"

colInner = input.color(
     color.green,
     "Inner band color",
     group = grpColor)

colOuter = input.color(
     color.red,
     "Outer band color",
     group = grpColor)

colMean = input.color(
     #FFCD00,
     "Mean line color",
     group = grpColor)

colMA = input.color(
     color.white,
     "200 SMMA color",
     group = grpColor)

colMAOutside = input.color(
     color.rgb(100, 181, 246),
     "200 SMMA outside color",
     group = grpColor)

colLong = input.color(
     color.green,
     "QQE Long color",
     group = grpColor)

colShort = input.color(
     color.red,
     "QQE Short color",
     group = grpColor)

colTP = input.color(
     color.orange,
     "TP target color",
     group = grpColor)

colSL = input.color(
     color.fuchsia,
     "Stop level color",
     group = grpColor)


// ============================================================================
// FILTER SETTINGS
// ============================================================================

grpFilters = "Filters"

enableMASideFilter = input.bool(
     true,
     "Require SMMA on the matching side (outer band)",
     group = grpFilters)

enablePriceGapFilter = input.bool(
     true,
     "Require price to have wicked into the gap zone",
     group = grpFilters)

gapFilterBand = input.string(
     "Inner",
     "Price-in-gap check band",
     options = ["Inner", "Outer"],
     group = grpFilters)


// ============================================================================
// TPT SESSION / CUTOFF SETTINGS
// ============================================================================

grpSession = "TPT Trading Hours"

// TPT flat deadline.
// Default = 5:00 PM New York time.
tptCloseHour = input.int(
     17,
     "TPT flat deadline hour (New York)",
     minval = 0,
     maxval = 23,
     group = grpSession)

tptCloseMinute = input.int(
     0,
     "TPT flat deadline minute",
     minval = 0,
     maxval = 59,
     group = grpSession)

// Block new trades this many minutes before TPT cutoff.
minutesBeforeClose = input.int(
     20,
     "Block new trades before TPT cutoff",
     minval = 0,
     group = grpSession)


// ============================================================================
// STOP LOSS SETTINGS
// ============================================================================

grpRisk = "Stop Loss"

// GENERAL FIXED STOP
slTicks = input.int(
     100,
     "Stop loss (ticks)",
     minval = 1,
     group = grpRisk)

showSL = input.bool(
     true,
     "Show stop level",
     group = grpRisk)

tickOverride = input.float(
     0.0,
     "Tick size override (0 = use symbol's own tick size)",
     minval = 0.0,
     group = grpRisk)


// ============================================================================
// QQE SETTINGS
// ============================================================================

grpQQE = "QQE"

RSI_Period = input.int(
     14,
     title = "RSI Length",
     group = grpQQE)

SF = input.int(
     5,
     title = "RSI Smoothing",
     group = grpQQE)

QQE = input.float(
     4.238,
     title = "Fast QQE Factor",
     group = grpQQE)

showTP = input.bool(
     true,
     title = "Show TP target",
     group = grpQQE)


// ============================================================================
// NEW YORK TIME
// ============================================================================

nyHour = hour(
     time,
     "America/New_York")

nyMinute = minute(
     time,
     "America/New_York")

currentMinutes =
     nyHour * 60 +
     nyMinute

tptCloseMinutes =
     tptCloseHour * 60 +
     tptCloseMinute

minutesUntilTPTClose =
     tptCloseMinutes -
     currentMinutes


// ============================================================================
// TPT TRADING PERMISSION
// ============================================================================
//
// IMPORTANT:
//
// There is NO 09:30-16:00 session restriction anymore.
//
// This means signals are allowed:
//   - NY
//   - London
//   - Asia
//   - Overnight
//
// The only daily restriction is the TPT cutoff window.
//
// Example with default settings:
//
//   4:39 PM ET  -> allowed
//   4:40 PM ET  -> blocked
//   4:50 PM ET  -> blocked
//   4:59 PM ET  -> blocked
//   5:00 PM ET  -> flat/reset
//
// ============================================================================

tptCutoffWindow =
     minutesUntilTPTClose >= 0 and
     minutesUntilTPTClose <= minutesBeforeClose

allowNewTrade =
     not tptCutoffWindow


// ============================================================================
// FORCE RESET AT TPT CUTOFF
// ============================================================================
//
// This prevents the indicator from visually carrying a trade through
// the TPT cutoff.
//
// The actual market/session itself is handled separately by the broker.
// ============================================================================

tptCutoffReached =
     currentMinutes >= tptCloseMinutes and
     currentMinutes < tptCloseMinutes + 1


// ============================================================================
// SUPER SMOOTHER
// ============================================================================

f_supersmoother(src, len) =>
    a1 = math.exp(
         -math.sqrt(2) * math.pi / len)

    b1 = 2 * a1 * math.cos(
         math.sqrt(2) * math.pi / len)

    c3 = -math.pow(a1, 2)
    c2 = b1
    c1 = 1 - c2 - c3

    var float ss = na

    ss := c1 * src +
         c2 * nz(ss[1], src[1]) +
         c3 * nz(ss[2], src[2])

    ss


// ============================================================================
// MRC CALCULATION
// ============================================================================

meanline = f_supersmoother(
     mrcSource,
     mrcLength)

meanrange = f_supersmoother(
     ta.tr,
     mrcLength)


// ============================================================================
// MRC MULTIPLIERS
// ============================================================================

multInner =
     math.pi * innerMult

multOuter =
     math.pi * outerMult


// ============================================================================
// MRC BANDS
// ============================================================================

// INNER

upperInner =
     meanline +
     meanrange * multInner

lowerInner =
     meanline -
     meanrange * multInner

// OUTER

upperOuter =
     meanline +
     meanrange * multOuter

lowerOuter =
     meanline -
     meanrange * multOuter


// ============================================================================
// 200 SMMA
// ============================================================================

maVal = ta.rma(
     close,
     maLen)


// ============================================================================
// SMMA / MRC RELATIONSHIP
// ============================================================================

maBelowOuter =
     maVal < lowerOuter

maAboveOuter =
     maVal > upperOuter

maOutsideMRC =
     maBelowOuter or
     maAboveOuter

maPlotColor =
     maOutsideMRC
     ? colMAOutside
     : colMA


// ============================================================================
// MRC PLOTS
// ============================================================================

pInnU = plot(
     upperInner,
     title = "MRC R1 (Inner)",
     color = color.new(colInner, 30),
     linewidth = 1)

pInnL = plot(
     lowerInner,
     title = "MRC S1 (Inner)",
     color = color.new(colInner, 30),
     linewidth = 1)

pOutU = plot(
     upperOuter,
     title = "MRC R2 (Outer)",
     color = color.new(colOuter, 20),
     linewidth = 1)

pOutL = plot(
     lowerOuter,
     title = "MRC S2 (Outer)",
     color = color.new(colOuter, 20),
     linewidth = 1)


// ============================================================================
// MRC SHADING
// ============================================================================

fill(
     pInnU,
     pOutU,
     color = showFill
         ? color.new(colOuter, 88)
         : na,
     title = "Upper MRC Shade")

fill(
     pInnL,
     pOutL,
     color = showFill
         ? color.new(colInner, 88)
         : na,
     title = "Lower MRC Shade")


// ============================================================================
// MRC MEAN
// ============================================================================

plot(
     showMean
         ? meanline
         : na,
     title = "MRC Mean",
     color = color.new(colMean, 0),
     linewidth = 2)


// ============================================================================
// 200 SMMA PLOT
// ============================================================================

plot(
     showMA
         ? maVal
         : na,
     title = "200 SMMA",
     color = color.new(maPlotColor, 0),
     linewidth = 2)


// ============================================================================
// QQE CALCULATION
// ============================================================================

src = close

Wilders_Period =
     RSI_Period * 2 - 1

Rsi =
     ta.rsi(
         src,
         RSI_Period)

RsiMa =
     ta.ema(
         Rsi,
         SF)

AtrRsi =
     math.abs(
         RsiMa[1] - RsiMa)

MaAtrRsi =
     ta.ema(
         AtrRsi,
         Wilders_Period)

dar =
     ta.ema(
         MaAtrRsi,
         Wilders_Period) * QQE


// ============================================================================
// QQE BANDS
// ============================================================================

var float longband = 0.0
var float shortband = 0.0
var int trend = 0

DeltaFastAtrRsi = dar
RSIndex = RsiMa

newshortband =
     RSIndex +
     DeltaFastAtrRsi

newlongband =
     RSIndex -
     DeltaFastAtrRsi

longband :=
     RSIndex[1] > longband[1] and
     RSIndex > longband[1]
     ? math.max(
         longband[1],
         newlongband)
     : newlongband

shortband :=
     RSIndex[1] < shortband[1] and
     RSIndex < shortband[1]
     ? math.min(
         shortband[1],
         newshortband)
     : newshortband


// ============================================================================
// QQE TREND
// ============================================================================
//
// (uses the counter-based signal below, not ta.cross directly — trend just
// tracks which band RSIndex is currently trailing)
// ============================================================================

trend :=
     ta.cross(RSIndex, shortband[1])
     ? 1
     : ta.cross(longband[1], RSIndex)
     ? -1
     : nz(
         trend[1],
         1)

FastAtrRsiTL =
     trend == 1
     ? longband
     : shortband


// ============================================================================
// FIND ALL QQE CROSSES
// ============================================================================

var int QQExlong = 0
var int QQExshort = 0

QQExlong :=
     FastAtrRsiTL < RSIndex
     ? QQExlong + 1
     : 0

QQExshort :=
     FastAtrRsiTL > RSIndex
     ? QQExshort + 1
     : 0


// ============================================================================
// ORIGINAL QQE CONDITIONS
// ============================================================================

qqeLongRaw =
     QQExlong == 1
     ? FastAtrRsiTL[1] - 50
     : na

qqeShortRaw =
     QQExshort == 1
     ? FastAtrRsiTL[1] - 50
     : na


// ============================================================================
// PRICE-IN-GAP FILTER
// ============================================================================

gapCheckUpper =
     gapFilterBand == "Inner"
     ? upperInner
     : upperOuter

gapCheckLower =
     gapFilterBand == "Inner"
     ? lowerInner
     : lowerOuter

priceInGapShort =
     high >= gapCheckUpper

priceInGapLong =
     low <= gapCheckLower


// ============================================================================
// QQE FILTERS
// ============================================================================

maLongOk =
     not enableMASideFilter or
     maBelowOuter

maShortOk =
     not enableMASideFilter or
     maAboveOuter

gapLongOk =
     not enablePriceGapFilter or
     priceInGapLong

gapShortOk =
     not enablePriceGapFilter or
     priceInGapShort


// ============================================================================
// TOUCH MEMORY (armed state)
// ============================================================================
//
// 2026-08-20 FIX (see header): a touch only counts if it happened while the
// bias already held (maLongOk/maShortOk true that bar) — matching "if
// above, short / if below, long" — and then STAYS armed across however
// many bars it takes for the QQE signal to actually print, instead of
// requiring both to land on the same bar. Clears the moment the bias
// itself breaks (SMMA back inside the channel, or flipped to the other
// side), or the moment a matching signal consumes it.
// ============================================================================

var bool longArmed = false
var bool shortArmed = false

if maLongOk and gapLongOk
    longArmed := true
if maShortOk and gapShortOk
    shortArmed := true

if enableMASideFilter and not maLongOk
    longArmed := false
if enableMASideFilter and not maShortOk
    shortArmed := false


// ============================================================================
// FINAL QQE SIGNALS
// ============================================================================
//
// The important change:
//
// There is NO NY-session restriction.
//
// The only entry restriction is the TPT cutoff window.
// ============================================================================

qqeLong =
     maLongOk and
     longArmed and
     allowNewTrade
     ? qqeLongRaw
     : na

qqeShort =
     maShortOk and
     shortArmed and
     allowNewTrade
     ? qqeShortRaw
     : na

// Consume the touch once it fires an entry.
if not na(qqeLong)
    longArmed := false
if not na(qqeShort)
    shortArmed := false


// ============================================================================
// TP + STOP TRACKING
// ============================================================================
//
// LONG:
//   TP = R1 / Upper Inner
//   SL = slTicks below entry
//
// SHORT:
//   TP = S1 / Lower Inner
//   SL = slTicks above entry
//
// ============================================================================

tick =
     tickOverride > 0
     ? tickOverride
     : syminfo.mintick

var int qqeDir = 0
var float slLevel = na
var float entryPriceTracked = na


// ============================================================================
// FORCE FLAT / CLEAR AT TPT DEADLINE
// ============================================================================

if tptCutoffReached
    qqeDir := 0
    slLevel := na
    entryPriceTracked := na


// ============================================================================
// LONG ENTRY
// ============================================================================

if not na(qqeLong) and not tptCutoffReached
    qqeDir := 1
    entryPriceTracked := close

    // EXACTLY slTicks BELOW ENTRY
    slLevel :=
         entryPriceTracked -
         slTicks * tick


// ============================================================================
// SHORT ENTRY
// ============================================================================

if not na(qqeShort) and not tptCutoffReached
    qqeDir := -1
    entryPriceTracked := close

    // EXACTLY slTicks ABOVE ENTRY
    slLevel :=
         entryPriceTracked +
         slTicks * tick


// ============================================================================
// LONG TP / SL
// ============================================================================

if qqeDir == 1

    // TP = R1 / Upper Inner
    if high >= upperInner
        qqeDir := 0
        slLevel := na
        entryPriceTracked := na

    // SL
    else if low <= slLevel
        qqeDir := 0
        slLevel := na
        entryPriceTracked := na


// ============================================================================
// SHORT TP / SL
// ============================================================================

if qqeDir == -1

    // TP = S1 / Lower Inner
    if low <= lowerInner
        qqeDir := 0
        slLevel := na
        entryPriceTracked := na

    // SL
    else if high >= slLevel
        qqeDir := 0
        slLevel := na
        entryPriceTracked := na


// ============================================================================
// TP LEVEL
// ============================================================================
//
// LONG  -> R1
// SHORT -> S1
//
// Dynamically follows the inner band.
// ============================================================================

tpLevel =
     qqeDir == 1
     ? upperInner
     : qqeDir == -1
     ? lowerInner
     : na


// ============================================================================
// SL LEVEL
// ============================================================================

slPlot =
     qqeDir != 0
     ? slLevel
     : na


// ============================================================================
// QQE SIGNAL PLOTS
// ============================================================================

plotshape(
     not na(qqeLong),
     title = "QQE Long",
     text = "Long",
     textcolor = color.white,
     style = shape.labelup,
     location = location.belowbar,
     color = colLong,
     size = size.tiny)

plotshape(
     not na(qqeShort),
     title = "QQE Short",
     text = "Short",
     textcolor = color.white,
     style = shape.labeldown,
     location = location.abovebar,
     color = colShort,
     size = size.tiny)


// ============================================================================
// TP TARGET
// ============================================================================

plot(
     showTP
         ? tpLevel
         : na,
     title = "TP Target - Inner Band",
     style = plot.style_circles,
     color = color.new(colTP, 0),
     linewidth = 3)


// ============================================================================
// STOP LEVEL
// ============================================================================

plot(
     showSL
         ? slPlot
         : na,
     title = "Stop Level",
     style = plot.style_circles,
     color = color.new(colSL, 0),
     linewidth = 3)


// ============================================================================
// ALERTS
// ============================================================================

alertcondition(
     not na(qqeLong),
     title = "QQE Long",
     message = "QQE Long")

alertcondition(
     not na(qqeShort),
     title = "QQE Short",
     message = "QQE Short")
