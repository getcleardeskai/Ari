//@version=6

// ============================================================================
// MRC (In/Out Bands) + 200 SMMA + QQE
//
// TP:
//   If signal fires OUTSIDE MRC:
//      LONG  -> R2 / Upper Outer Band
//      SHORT -> S2 / Lower Outer Band
//
//   If signal fires INSIDE MRC:
//      LONG  -> R1 / Upper Inner Band
//      SHORT -> S1 / Lower Inner Band
//
// TP follows the selected MRC band live.
//
// SL:
//   Initial size = slRatio (default 0.7) x the TP distance from entry at
//   entry time. Example, slRatio = 0.7:
//      Long entry 7000
//      TP at entry 7010 (10-point distance)
//      SL = 7000 - (10 x 0.7) = 6993
//
//   After entry, the SL TRAILS the TP's own movement, at slTrailSpeed
//   (default 0.5, i.e. half speed) of however far the TP has moved from
//   its entry-time value — same mechanism as the TP following its band,
//   just scaled down and applied to the SL's starting point instead.
//   Example: TP moves up 10 points from where it was at entry -> SL moves
//   up 10 x 0.5 = 5 points from where IT was at entry. Not a ratchet: if
//   the TP band gives back ground, the SL gives back proportionally too.
//
// TPT:
//   Full futures session allowed.
//   New trades blocked during the final minutes before TPT cutoff.
//   Tracked trade is cleared at cutoff.
// ============================================================================

indicator("MRC (In/Out Bands) + 200 SMMA + QQE", overlay = true, max_lines_count = 500)


// ============================================================================
// INPUTS
// ============================================================================

grpMRC = "MRC"

mrcSource = input.source(
     hlc3,
     "Price source",
     group = grpMRC)

mrcLength = input.int(
     200,
     "Lookback period",
     minval = 1,
     group = grpMRC)

innerMult = input.float(
     1.0,
     "Inner channel size multiplier",
     minval = 0.1,
     group = grpMRC)

outerMult = input.float(
     2.415,
     "Outer channel size multiplier",
     minval = 0.1,
     group = grpMRC)

showMean = input.bool(
     false,
     "Show MRC mean line",
     group = grpMRC)

showFill = input.bool(
     true,
     "Shade between inner and outer bands",
     group = grpMRC)


// ============================================================================
// 200 SMMA SETTINGS
// ============================================================================

grpMA = "200 SMMA"

maLen = input.int(
     200,
     "SMMA length",
     minval = 1,
     group = grpMA)

showMA = input.bool(
     true,
     "Show 200 SMMA",
     group = grpMA)


// ============================================================================
// COLOR SETTINGS
// ============================================================================

grpColor = "Colors"

colInner = input.color(
     color.green,
     "Inner band color",
     group = grpColor)

colOuter = input.color(
     color.red,
     "Outer band color",
     group = grpColor)

colMean = input.color(
     #FFCD00,
     "Mean line color",
     group = grpColor)

colMA = input.color(
     color.white,
     "200 SMMA color",
     group = grpColor)

colMAOutside = input.color(
     color.rgb(100, 181, 246),
     "200 SMMA outside color",
     group = grpColor)

colTP = input.color(
     color.orange,
     "TP target color",
     group = grpColor)

colSL = input.color(
     color.fuchsia,
     "Stop level color",
     group = grpColor)


// ============================================================================
// TPT SESSION / CUTOFF SETTINGS
// ============================================================================

grpSession = "TPT Trading Hours"

tptCloseHour = input.int(
     17,
     "TPT flat deadline hour (New York)",
     minval = 0,
     maxval = 23,
     group = grpSession)

tptCloseMinute = input.int(
     0,
     "TPT flat deadline minute",
     minval = 0,
     maxval = 59,
     group = grpSession)

minutesBeforeClose = input.int(
     20,
     "Block new trades before TPT cutoff",
     minval = 0,
     group = grpSession)


// ============================================================================
// RISK SETTINGS
// ============================================================================

grpRisk = "Risk / Stop Loss"

showSL = input.bool(
     true,
     "Show stop level",
     group = grpRisk)

slRatio = input.float(
     0.7,
     "Initial SL size (x the TP distance at entry)",
     minval = 0.01,
     group = grpRisk)

slTrailSpeed = input.float(
     0.5,
     "SL trail speed (x the TP's own movement since entry)",
     minval = 0.0,
     group = grpRisk)

tickOverride = input.float(
     0.0,
     "Tick size override (0 = use symbol's own tick size)",
     minval = 0.0,
     group = grpRisk)


// ============================================================================
// QQE SETTINGS
// ============================================================================

grpQQE = "QQE"

RSI_Period = input.int(
     14,
     title = "RSI Length",
     group = grpQQE)

SF = input.int(
     5,
     title = "RSI Smoothing",
     group = grpQQE)

QQE = input.float(
     4.238,
     title = "Fast QQE Factor",
     group = grpQQE)

ThreshHold = input.int(
     10,
     title = "Thresh-hold",
     group = grpQQE)

showTP = input.bool(
     true,
     title = "Show TP target",
     group = grpQQE)


// ============================================================================
// NEW YORK TIME
// ============================================================================

nyHour = hour(time, "America/New_York")
nyMinute = minute(time, "America/New_York")

currentMinutes = nyHour * 60 + nyMinute

tptCloseMinutes = tptCloseHour * 60 + tptCloseMinute

minutesUntilTPTClose = tptCloseMinutes - currentMinutes


// ============================================================================
// TPT TRADING PERMISSION
// ============================================================================

tptCutoffWindow =
     minutesUntilTPTClose >= 0 and
     minutesUntilTPTClose <= minutesBeforeClose

allowNewTrade = not tptCutoffWindow

tptCutoffReached =
     currentMinutes >= tptCloseMinutes and
     currentMinutes < tptCloseMinutes + 1


// ============================================================================
// SUPER SMOOTHER
// ============================================================================

f_supersmoother(src, len) =>
    a1 = math.exp(
         -math.sqrt(2) * math.pi / len)

    b1 = 2 * a1 * math.cos(
         math.sqrt(2) * math.pi / len)

    c3 = -math.pow(a1, 2)
    c2 = b1
    c1 = 1 - c2 - c3

    var float ss = na

    ss := c1 * src +
         c2 * nz(ss[1], src[1]) +
         c3 * nz(ss[2], src[2])

    ss


// ============================================================================
// MRC CALCULATION
// ============================================================================

meanline = f_supersmoother(
     mrcSource,
     mrcLength)

meanrange = f_supersmoother(
     ta.tr,
     mrcLength)


// ============================================================================
// MRC MULTIPLIERS
// ============================================================================

multInner = math.pi * innerMult
multOuter = math.pi * outerMult


// ============================================================================
// MRC BANDS
// ============================================================================

upperInner = meanline + (meanrange * multInner)
lowerInner = meanline - (meanrange * multInner)

upperOuter = meanline + (meanrange * multOuter)
lowerOuter = meanline - (meanrange * multOuter)


// ============================================================================
// 200 SMMA
// ============================================================================

maVal = ta.rma(close, maLen)


// ============================================================================
// SMMA / MRC RELATIONSHIP
// ============================================================================

maBelowOuter = maVal < lowerOuter
maAboveOuter = maVal > upperOuter

maOutsideMRC = maBelowOuter or maAboveOuter

maPlotColor = maOutsideMRC
     ? colMAOutside
     : colMA


// ============================================================================
// MRC PLOTS
// ============================================================================

pInnU = plot(
     upperInner,
     title = "MRC R1 (Inner)",
     color = color.new(colInner, 30),
     linewidth = 1)

pInnL = plot(
     lowerInner,
     title = "MRC S1 (Inner)",
     color = color.new(colInner, 30),
     linewidth = 1)

pOutU = plot(
     upperOuter,
     title = "MRC R2 (Outer)",
     color = color.new(colOuter, 20),
     linewidth = 1)

pOutL = plot(
     lowerOuter,
     title = "MRC S2 (Outer)",
     color = color.new(colOuter, 20),
     linewidth = 1)


// ============================================================================
// MRC SHADING
// ============================================================================

fill(
     pInnU,
     pOutU,
     color = showFill
          ? color.new(colOuter, 88)
          : na,
     title = "Upper MRC Shade")

fill(
     pInnL,
     pOutL,
     color = showFill
          ? color.new(colInner, 88)
          : na,
     title = "Lower MRC Shade")


// ============================================================================
// MRC MEAN
// ============================================================================

plot(
     showMean ? meanline : na,
     title = "MRC Mean",
     color = color.new(colMean, 0),
     linewidth = 2)


// ============================================================================
// 200 SMMA
// ============================================================================

plot(
     showMA ? maVal : na,
     title = "200 SMMA",
     color = color.new(maPlotColor, 0),
     linewidth = 2)


// ============================================================================
// QQE CALCULATION
// ============================================================================

src = close

Wilders_Period = RSI_Period * 2 - 1

Rsi = ta.rsi(src, RSI_Period)

RsiMa = ta.ema(Rsi, SF)

AtrRsi = math.abs(RsiMa[1] - RsiMa)

MaAtrRsi = ta.ema(
     AtrRsi,
     Wilders_Period)

dar = ta.ema(
     MaAtrRsi,
     Wilders_Period) * QQE


// ============================================================================
// QQE BANDS
// ============================================================================

var float longband = 0.0
var float shortband = 0.0
var int trend = 0

DeltaFastAtrRsi = dar
RSIndex = RsiMa

newshortband = RSIndex + DeltaFastAtrRsi
newlongband = RSIndex - DeltaFastAtrRsi

longband :=
     RSIndex[1] > longband[1] and
     RSIndex > longband[1]
     ? math.max(longband[1], newlongband)
     : newlongband

shortband :=
     RSIndex[1] < shortband[1] and
     RSIndex < shortband[1]
     ? math.min(shortband[1], newshortband)
     : newshortband


// ============================================================================
// QQE TREND
// ============================================================================

crossLongBand = ta.cross(longband[1], RSIndex)

crossShortBand = ta.cross(RSIndex, shortband[1])

trend :=
     crossShortBand
     ? 1
     : crossLongBand
     ? -1
     : nz(trend[1], 1)

FastAtrRsiTL =
     trend == 1
     ? longband
     : shortband


// ============================================================================
// FIND ALL QQE CROSSES
// ============================================================================

var int QQExlong = 0
var int QQExshort = 0

QQExlong :=
     FastAtrRsiTL < RSIndex
     ? QQExlong + 1
     : 0

QQExshort :=
     FastAtrRsiTL > RSIndex
     ? QQExshort + 1
     : 0


// ============================================================================
// ORIGINAL QQE CONDITIONS
// ============================================================================

qqeLongRaw =
     QQExlong == 1
     ? FastAtrRsiTL[1] - 50
     : na

qqeShortRaw =
     QQExshort == 1
     ? FastAtrRsiTL[1] - 50
     : na


// ============================================================================
// PRICE-IN-GAP FILTER
// ============================================================================

priceInGapShort = high >= upperInner
priceInGapLong  = low <= lowerInner


// ============================================================================
// QQE ENTRY FILTER
// ============================================================================

qqeLong =
     maBelowOuter and
     priceInGapLong and
     allowNewTrade
     ? qqeLongRaw
     : na

qqeShort =
     maAboveOuter and
     priceInGapShort and
     allowNewTrade
     ? qqeShortRaw
     : na


// ============================================================================
// TP + TRAILING STOP TRACKING
// ============================================================================
//
// IMPORTANT:
//
// The TP selected at entry depends on where PRICE is relative to the MRC:
//
// LONG:
//   Price above upperInner / outside MRC -> R2
//   Price inside MRC                    -> R1
//
// SHORT:
//   Price below lowerInner / outside MRC -> S2
//   Price inside MRC                     -> S1
//
// Once selected, that band is followed LIVE.
//
// The SL's INITIAL size is calculated ONCE at entry, as slRatio x the
// distance from entry to the TP at that moment:
//
// LONG example (slRatio = 0.7):
// Entry = 7000
// Initial TP = 7010 (10-point distance)
// SL = 7000 - (10 x 0.7) = 6993
//
// After that, the SL TRAILS the TP's own movement (not price directly) at
// slTrailSpeed — `initialTPTracked`/`initialSLTracked` remember the
// entry-time TP and SL, and every bar the live SL is recomputed as the
// entry-time SL plus slTrailSpeed x however far the TP has moved since
// entry. Not a ratchet: if the TP band gives back ground, the SL follows
// it back too, proportionally.
// ============================================================================

var int qqeDir = 0

var float entryPriceTracked = na
var float slLevel = na
var float tpLevel = na

// Entry-time snapshots the trailing SL is computed relative to.
var float initialTPTracked = na
var float initialSLTracked = na

// 1 = inner TP
// 2 = outer TP
var int tpBand = 0


// ============================================================================
// FORCE FLAT AT TPT DEADLINE
// ============================================================================

if tptCutoffReached
    qqeDir := 0
    entryPriceTracked := na
    slLevel := na
    tpLevel := na
    initialTPTracked := na
    initialSLTracked := na
    tpBand := 0


// ============================================================================
// LONG ENTRY
// ============================================================================

if not na(qqeLong) and not tptCutoffReached

    qqeDir := 1

    entryPriceTracked := close

    // If price is above the inner band, it is outside the MRC
    // on the upper side -> use outer band.
    //
    // Otherwise use the inner band.
    tpBand :=
         close > upperInner
         ? 2
         : 1

    // Capture the TP value at the exact moment of entry.
    initialTP =
         tpBand == 2
         ? upperOuter
         : upperInner

    // Initial risk = slRatio x the TP distance.
    riskDistance = math.abs(initialTP - entryPriceTracked) * slRatio

    slLevel := entryPriceTracked - riskDistance

    tpLevel := initialTP

    initialTPTracked := initialTP
    initialSLTracked := slLevel


// ============================================================================
// SHORT ENTRY
// ============================================================================

if not na(qqeShort) and not tptCutoffReached

    qqeDir := -1

    entryPriceTracked := close

    // If price is below the inner band, it is outside the MRC
    // on the lower side -> use outer band.
    //
    // Otherwise use the inner band.
    tpBand :=
         close < lowerInner
         ? 2
         : 1

    // Capture TP value at entry.
    initialTP =
         tpBand == 2
         ? lowerOuter
         : lowerInner

    // Initial risk = slRatio x the TP distance.
    riskDistance = math.abs(entryPriceTracked - initialTP) * slRatio

    slLevel := entryPriceTracked + riskDistance

    tpLevel := initialTP

    initialTPTracked := initialTP
    initialSLTracked := slLevel


// ============================================================================
// LIVE TP FOLLOWING + SL TRAILING
// ============================================================================

if qqeDir == 1

    // Long follows selected upper band.
    tpLevel :=
         tpBand == 2
         ? upperOuter
         : upperInner

    // SL trails at slTrailSpeed x however far TP has moved since entry.
    slLevel := initialSLTracked + slTrailSpeed * (tpLevel - initialTPTracked)


if qqeDir == -1

    // Short follows selected lower band.
    tpLevel :=
         tpBand == 2
         ? lowerOuter
         : lowerInner

    // SL trails at slTrailSpeed x however far TP has moved since entry
    // (favorable direction for a short is DOWN, so this is subtracted).
    slLevel := initialSLTracked - slTrailSpeed * (initialTPTracked - tpLevel)


// ============================================================================
// LONG TP / SL
// ============================================================================

if qqeDir == 1

    // TP
    if high >= tpLevel
        qqeDir := 0
        entryPriceTracked := na
        slLevel := na
        tpLevel := na
        initialTPTracked := na
        initialSLTracked := na
        tpBand := 0

    // SL
    else if low <= slLevel
        qqeDir := 0
        entryPriceTracked := na
        slLevel := na
        tpLevel := na
        initialTPTracked := na
        initialSLTracked := na
        tpBand := 0


// ============================================================================
// SHORT TP / SL
// ============================================================================

if qqeDir == -1

    // TP
    if low <= tpLevel
        qqeDir := 0
        entryPriceTracked := na
        slLevel := na
        tpLevel := na
        initialTPTracked := na
        initialSLTracked := na
        tpBand := 0

    // SL
    else if high >= slLevel
        qqeDir := 0
        entryPriceTracked := na
        slLevel := na
        tpLevel := na
        initialTPTracked := na
        initialSLTracked := na
        tpBand := 0


// ============================================================================
// PLOTS
// ============================================================================

slPlot =
     qqeDir != 0
     ? slLevel
     : na


// ============================================================================
// QQE SIGNALS
// ============================================================================

plotshape(
     not na(qqeLong),
     title = "QQE Long",
     text = "Long",
     textcolor = color.white,
     style = shape.labelup,
     location = location.belowbar,
     color = color.green,
     size = size.tiny)

plotshape(
     not na(qqeShort),
     title = "QQE Short",
     text = "Short",
     textcolor = color.white,
     style = shape.labeldown,
     location = location.abovebar,
     color = color.red,
     size = size.tiny)


// ============================================================================
// TP TARGET
// ============================================================================

plot(
     showTP ? tpLevel : na,
     title = "TP Target",
     style = plot.style_circles,
     color = color.new(colTP, 0),
     linewidth = 3)


// ============================================================================
// STOP LEVEL
// ============================================================================

plot(
     showSL ? slPlot : na,
     title = "1:1 Stop Level",
     style = plot.style_circles,
     color = color.new(colSL, 0),
     linewidth = 3)


// ============================================================================
// ALERTS
// ============================================================================

alertcondition(
     not na(qqeLong),
     title = "QQE Long",
     message = "QQE Long")

alertcondition(
     not na(qqeShort),
     title = "QQE Short",
     message = "QQE Short")
