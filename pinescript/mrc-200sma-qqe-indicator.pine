//@version=6

// ============================================================================
// MRC (In/Out Bands) + 200 SMMA + QQE
//
// 2026-08-20 — trader-driven rewrite (session-based exit, hard-tick stop,
// TP-band-by-location, opacity, decluttering). Root cause of "takes no
// trades / can't see TP or SL" in the previous draft: `entryLong`/
// `entryShort` required `inSession` (the full "0930-1600" window) to be
// true for ANY entry to fire. That restricts trading to ~5.5 hours a day —
// with zero entries, `tradeDirection` never leaves 0, so TP/SL (which only
// plot when a trade is active) never had anything to draw. Fixed below:
// entries are now blocked ONLY in the N-minute window right before the
// session's close, not gated on being inside the session at all — matches
// "not take trades within 20 minutes of market close" literally, not
// "only trade during market hours."
// ============================================================================

indicator("MRC (In/Out Bands) + 200 SMMA + QQE", overlay = true, max_lines_count = 500)

// ============================================================================
// MRC
// ============================================================================

grpMRC = "MRC"

mrcSource = input.source(hlc3, "Price source", group = grpMRC)
mrcLength = input.int(200, "Lookback period", minval = 1, group = grpMRC)
innerMult = input.float(1.0, "Inner channel size multiplier", minval = 0.1, group = grpMRC)
outerMult = input.float(2.415, "Outer channel size multiplier", minval = 0.1, group = grpMRC)
showMean = input.bool(false, "Show MRC mean line", group = grpMRC)
showFill = input.bool(true, "Shade between inner and outer bands", group = grpMRC)

// ============================================================================
// 200 SMMA
// ============================================================================

grpMA = "200 SMMA"

maLen = input.int(200, "SMMA length", minval = 1, group = grpMA)
showMA = input.bool(true, "Show 200 SMMA", group = grpMA)

// ============================================================================
// COLORS
// ============================================================================

grpColor = "Colors"

colInner = input.color(color.green, "Inner band color", group = grpColor)
colOuter = input.color(color.red, "Outer band color", group = grpColor)
colMean = input.color(#FFCD00, "Mean line color", group = grpColor)
colMA = input.color(color.white, "200 SMMA color", group = grpColor)
colMAOutside = input.color(color.rgb(100, 181, 246), "200 SMMA outside color", group = grpColor)

colTP = input.color(color.orange, "TP line color", group = grpColor)
colSL = input.color(color.fuchsia, "SL line color", group = grpColor)

// ============================================================================
// OPACITY
// ============================================================================
//
// Convention (matches the trader's own draft): these numbers ARE Pine's
// `transparency` value directly — 0 = fully solid, 100 = fully invisible.
//
// 2026-08-20 FIX: the Mean line and 200 SMMA plots didn't pass through
// color.new() at all in the last draft — they used the raw color input, so
// their opacity sliders (meanOpacity/maOpacity, now added below) had zero
// effect. Every plotted line now actually routes through its opacity input.
//
// 2026-08-20, also added: "quiet" decluttering. `idleOpacity` (default 90,
// i.e. mostly faded) applies to the MRC bands / mean / SMMA / shading
// whenever `conditionsActive` is false; each element's own opacity input
// above takes back over the instant conditions go active (SMMA turns
// light-blue, or a trade is open) — so the chart stays quiet until
// something is actually worth looking at.
// ============================================================================

grpOpacity = "Opacity"

innerOpacity = input.int(30, "Inner band opacity (active)", minval = 0, maxval = 100, group = grpOpacity)
outerOpacity = input.int(20, "Outer band opacity (active)", minval = 0, maxval = 100, group = grpOpacity)
fillOpacity = input.int(88, "MRC fill opacity (active)", minval = 0, maxval = 100, group = grpOpacity)
meanOpacity = input.int(0, "Mean line opacity (active)", minval = 0, maxval = 100, group = grpOpacity)
maOpacity = input.int(0, "200 SMMA opacity (active)", minval = 0, maxval = 100, group = grpOpacity)
tpOpacity = input.int(0, "TP opacity", minval = 0, maxval = 100, group = grpOpacity)
slOpacity = input.int(0, "SL opacity", minval = 0, maxval = 100, group = grpOpacity)

declutter = input.bool(true, "Fade bands/mean/SMMA when no setup is active", group = grpOpacity)
idleOpacity = input.int(90, "Idle opacity (bands/mean/SMMA when nothing active)", minval = 0, maxval = 100, group = grpOpacity)

// ============================================================================
// FILTERS
// ============================================================================

grpFilters = "Filters"

enableMASideFilter = input.bool(true, "Require SMMA on matching side", group = grpFilters)
enablePriceGapFilter = input.bool(true, "Require price to reach MRC", group = grpFilters)
gapFilterBand = input.string("Inner", "Price-in-gap check band", options = ["Inner", "Outer"], group = grpFilters)

// ============================================================================
// MARKET SESSION
// ============================================================================
//
// `sessionInput` defines the daily window whose CLOSE matters for two
// things: (1) force-flatten any open trade the moment this window ends
// ("stop out on market session change"), and (2) block new entries in the
// last `sessionBufferMinutes` before that close. Entries are NOT otherwise
// restricted to this window — outside it (overnight/extended hours),
// trading is unrestricted, since futures trade nearly 24/5 and this is a
// "don't trade right into the close" rule, not an "only trade RTH" rule.
// ============================================================================

grpSession = "Market Session"

sessionInput = input.session("0930-1600", "Session (its close drives the flatten + buffer)", group = grpSession)
sessionBufferMinutes = input.int(20, "Block new entries this many minutes before session close", minval = 0, group = grpSession)

sessionCloseStr = str.substring(sessionInput, 5, 9)

closeHour = int(str.tonumber(str.substring(sessionCloseStr, 0, 2)))
closeMin = int(str.tonumber(str.substring(sessionCloseStr, 2, 4)))

bufferedTotalMin = math.max((closeHour * 60 + closeMin) - sessionBufferMinutes, 0)
bufferedHour = bufferedTotalMin / 60
bufferedMin = bufferedTotalMin % 60

f_pad2(n) => n < 10 ? "0" + str.tostring(n) : str.tostring(n)

// A standalone session string covering ONLY the pre-close buffer window
// (e.g. "1540-1600") — deliberately NOT anchored to the session's open, so
// it's checkable at any hour of the day, not just while already "in session".
preCloseWindow = f_pad2(bufferedHour) + f_pad2(bufferedMin) + "-" + sessionCloseStr

inSession = not na(time(timeframe.period, sessionInput))
sessionEnded = inSession[1] and not inSession   // the moment the session closes -> force flatten

blockedNow = sessionBufferMinutes > 0 and not na(time(timeframe.period, preCloseWindow))

// ============================================================================
// HARD STOP
// ============================================================================

grpRisk = "Hard Stop"

showSL = input.bool(true, "Show hard stop", group = grpRisk)
hardStopTicks = input.int(250, "Hard stop distance (ticks)", minval = 1, group = grpRisk)
tickOverride = input.float(0.0, "Tick size override (0 = symbol tick size)", minval = 0.0, group = grpRisk)

// ============================================================================
// QQE
// ============================================================================

grpQQE = "QQE"

RSI_Period = input.int(14, "RSI Length", minval = 1, group = grpQQE)
SF = input.int(5, "RSI Smoothing", minval = 1, group = grpQQE)
QQE = input.float(4.238, "Fast QQE Factor", group = grpQQE)
ThreshHold = input.int(10, "Thresh-hold", group = grpQQE)
showTP = input.bool(true, "Show TP line", group = grpQQE)

qqeLongColor = input.color(color.green, "QQE Long color", group = grpQQE)
qqeShortColor = input.color(color.red, "QQE Short color", group = grpQQE)
qqeSignalOpacity = input.int(0, "QQE signal opacity", minval = 0, maxval = 100, group = grpQQE)
qqeTextColor = input.color(color.white, "QQE signal text color", group = grpQQE)

// ============================================================================
// SUPER SMOOTHER
// ============================================================================

f_supersmoother(src, len) =>
    a1 = math.exp(-math.sqrt(2) * math.pi / len)
    b1 = 2.0 * a1 * math.cos(math.sqrt(2) * math.pi / len)
    c3 = -math.pow(a1, 2)
    c2 = b1
    c1 = 1.0 - c2 - c3

    var float ss = na

    ss := c1 * src +
         c2 * nz(ss[1], src[1]) +
         c3 * nz(ss[2], src[2])

    ss

// ============================================================================
// MRC CALCULATION
// ============================================================================

meanline = f_supersmoother(mrcSource, mrcLength)
meanrange = f_supersmoother(ta.tr, mrcLength)

multInner = math.pi * innerMult
multOuter = math.pi * outerMult

upperInner = meanline + meanrange * multInner
lowerInner = meanline - meanrange * multInner

upperOuter = meanline + meanrange * multOuter
lowerOuter = meanline - meanrange * multOuter

// ============================================================================
// 200 SMMA
// ============================================================================

maVal = ta.rma(close, maLen)

maBelowOuter = maVal < lowerOuter
maAboveOuter = maVal > upperOuter
maOutsideMRC = maBelowOuter or maAboveOuter

maPlotColor = maOutsideMRC ? colMAOutside : colMA

// ============================================================================
// TRADE STATE — declared here (ahead of TRADE TRACKING further down) purely
// so DECLUTTER STATE below can read `tradeDirection`. It's still only
// ASSIGNED in the TRADE TRACKING section later in the script; reading it up
// here just sees last bar's value until this bar's tracking logic runs
// further down (one-bar lag on the opacity switch only, cosmetic).
// ============================================================================

var int tradeDirection = 0
var float tradeEntry = na
var float tradeTP = na
var float tradeSL = na
var bool tradeJustStarted = false

// ============================================================================
// DECLUTTER STATE — drives the idle-vs-active opacity on the persistent
// lines (bands/mean/SMMA/shading). "Active" = the SMMA is outside the
// outer band (a setup could be forming) OR a trade is currently open.
// ============================================================================

conditionsActive = maOutsideMRC or tradeDirection != 0

// ============================================================================
// MRC PLOTS
// ============================================================================
//
// f_eff() resolves each element's actual on-chart opacity: its own
// "active" opacity input normally, or the shared `idleOpacity` whenever
// `declutter` is on and nothing is currently active.
// ============================================================================

f_eff(activeOp) => declutter and not conditionsActive ? idleOpacity : activeOp

pInnU = plot(upperInner, "MRC R1 (Inner)", color = color.new(colInner, f_eff(innerOpacity)), linewidth = 1)
pInnL = plot(lowerInner, "MRC S1 (Inner)", color = color.new(colInner, f_eff(innerOpacity)), linewidth = 1)
pOutU = plot(upperOuter, "MRC R2 (Outer)", color = color.new(colOuter, f_eff(outerOpacity)), linewidth = 1)
pOutL = plot(lowerOuter, "MRC S2 (Outer)", color = color.new(colOuter, f_eff(outerOpacity)), linewidth = 1)

fill(pInnU, pOutU, color = showFill ? color.new(colOuter, f_eff(fillOpacity)) : na, title = "Upper MRC Shade")
fill(pInnL, pOutL, color = showFill ? color.new(colInner, f_eff(fillOpacity)) : na, title = "Lower MRC Shade")

plot(showMean ? meanline : na, "MRC Mean", color = color.new(colMean, f_eff(meanOpacity)), linewidth = 2)
plot(showMA ? maVal : na, "200 SMMA", color = color.new(maPlotColor, f_eff(maOpacity)), linewidth = 2)

// ============================================================================
// QQE CALCULATION
// ============================================================================

src = close

Wilders_Period = RSI_Period * 2 - 1

Rsi = ta.rsi(src, RSI_Period)
RsiMa = ta.ema(Rsi, SF)

AtrRsi = math.abs(RsiMa[1] - RsiMa)

MaAtrRsi = ta.ema(AtrRsi, Wilders_Period)

dar = ta.ema(MaAtrRsi, Wilders_Period) * QQE

// ============================================================================
// QQE BANDS
// ============================================================================

var float longband = na
var float shortband = na
var int trend = 0

DeltaFastAtrRsi = dar
RSIndex = RsiMa

newshortband = RSIndex + DeltaFastAtrRsi
newlongband = RSIndex - DeltaFastAtrRsi

longband := na(longband[1]) ?
     newlongband :
     RSIndex[1] > longband[1] and RSIndex > longband[1] ?
     math.max(longband[1], newlongband) :
     newlongband

shortband := na(shortband[1]) ?
     newshortband :
     RSIndex[1] < shortband[1] and RSIndex < shortband[1] ?
     math.min(shortband[1], newshortband) :
     newshortband

// ============================================================================
// QQE TREND
// ============================================================================

crossLongBand = ta.cross(longband[1], RSIndex)
crossShortBand = ta.cross(RSIndex, shortband[1])

trend := crossShortBand ?
     1 :
     crossLongBand ?
     -1 :
     nz(trend[1], 1)

FastAtrRsiTL = trend == 1 ? longband : shortband

// ============================================================================
// QQE CROSS COUNTERS
// ============================================================================

var int QQExlong = 0
var int QQExshort = 0

QQExlong := FastAtrRsiTL < RSIndex ? QQExlong + 1 : 0
QQExshort := FastAtrRsiTL > RSIndex ? QQExshort + 1 : 0

// ============================================================================
// RAW QQE SIGNALS
// ============================================================================

qqeLongRaw = QQExlong == 1 ? FastAtrRsiTL[1] - 50 : na
qqeShortRaw = QQExshort == 1 ? FastAtrRsiTL[1] - 50 : na

rawLong = not na(qqeLongRaw)
rawShort = not na(qqeShortRaw)

// ============================================================================
// PRICE LOCATION AT SIGNAL — drives TP band selection (request #3)
// ============================================================================

priceBelowMRC = close < lowerOuter
priceAboveMRC = close > upperOuter
priceOutsideMRC = priceBelowMRC or priceAboveMRC

// ============================================================================
// PRICE-IN-GAP FILTER
// ============================================================================

gapCheckUpper = gapFilterBand == "Inner" ? upperInner : upperOuter
gapCheckLower = gapFilterBand == "Inner" ? lowerInner : lowerOuter

priceInGapShort = high >= gapCheckUpper
priceInGapLong = low <= gapCheckLower

// ============================================================================
// FILTERS
// ============================================================================

maLongOk = not enableMASideFilter or maBelowOuter
maShortOk = not enableMASideFilter or maAboveOuter
gapLongOk = not enablePriceGapFilter or priceInGapLong
gapShortOk = not enablePriceGapFilter or priceInGapShort

filteredLong = rawLong and maLongOk and gapLongOk
filteredShort = rawShort and maShortOk and gapShortOk

// ============================================================================
// ENTRIES
// ============================================================================
//
// Blocked ONLY in the pre-close buffer window (see MARKET SESSION above) —
// NOT gated on being inside the session generally. This is the fix for
// "takes no trades": the old `and inSession` requirement here restricted
// every entry to a ~5.5-hour daytime window.
// ============================================================================

entryLong = filteredLong and not blockedNow
entryShort = filteredShort and not blockedNow

// ============================================================================
// TRADE TRACKING
// ============================================================================

tick = tickOverride > 0 ? tickOverride : syminfo.mintick

// (tradeDirection / tradeEntry / tradeTP / tradeSL / tradeJustStarted are
// declared earlier, up in TRADE STATE, so DECLUTTER STATE can read them)

// Session change -> force flatten ("stop out on market session change")
if sessionEnded
    tradeDirection := 0
    tradeEntry := na
    tradeTP := na
    tradeSL := na
    tradeJustStarted := false

// New long
if entryLong
    tradeDirection := 1
    tradeEntry := close
    tradeJustStarted := true
    tradeSL := close - hardStopTicks * tick
    tradeTP := priceOutsideMRC ? upperOuter : upperInner   // 2nd (outer) band if price was outside MRC, 1st (inner/closer) if inside

// New short
if entryShort
    tradeDirection := -1
    tradeEntry := close
    tradeJustStarted := true
    tradeSL := close + hardStopTicks * tick
    tradeTP := priceOutsideMRC ? lowerOuter : lowerInner

// TP keeps tracking whichever band type (inner/outer) was chosen at entry,
// live, as that band itself moves — re-derived every bar from whether the
// ENTRY price was outside/inside the MRC (frozen classification, moving band).
if tradeDirection == 1
    tradeTP := (tradeEntry < lowerOuter or tradeEntry > upperOuter) ? upperOuter : upperInner

if tradeDirection == -1
    tradeTP := (tradeEntry < lowerOuter or tradeEntry > upperOuter) ? lowerOuter : lowerInner

// Don't check TP/SL on the same candle as the signal, so the line is
// guaranteed to actually be visible for at least one bar after it prints.
if tradeJustStarted
    tradeJustStarted := false
else
    if tradeDirection == 1
        if high >= tradeTP
            tradeDirection := 0
            tradeEntry := na
            tradeTP := na
            tradeSL := na
        else if low <= tradeSL
            tradeDirection := 0
            tradeEntry := na
            tradeTP := na
            tradeSL := na

    if tradeDirection == -1
        if low <= tradeTP
            tradeDirection := 0
            tradeEntry := na
            tradeTP := na
            tradeSL := na
        else if high >= tradeSL
            tradeDirection := 0
            tradeEntry := na
            tradeTP := na
            tradeSL := na

// ============================================================================
// SIGNAL LABELS
// ============================================================================

plotshape(filteredLong, title = "QQE Long", text = "Long", textcolor = qqeTextColor,
     style = shape.labelup, location = location.belowbar,
     color = color.new(qqeLongColor, qqeSignalOpacity), size = size.tiny)

plotshape(filteredShort, title = "QQE Short", text = "Short", textcolor = qqeTextColor,
     style = shape.labeldown, location = location.abovebar,
     color = color.new(qqeShortColor, qqeSignalOpacity), size = size.tiny)

// ============================================================================
// TP / SL LINES
// ============================================================================

plot(showTP and tradeDirection != 0 ? tradeTP : na, title = "TP Target",
     color = color.new(colTP, tpOpacity), linewidth = 3, style = plot.style_linebr)

plot(showSL and tradeDirection != 0 ? tradeSL : na, title = "Hard Stop",
     color = color.new(colSL, slOpacity), linewidth = 3, style = plot.style_linebr)

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(entryLong, title = "QQE Long", message = "QQE Long")
alertcondition(entryShort, title = "QQE Short", message = "QQE Short")
