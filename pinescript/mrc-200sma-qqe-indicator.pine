//@version=6

// ============================================================================
// MRC (In/Out Bands) + 200 SMMA + QQE
//
// 2026-08-20 — MERGE: the entry/signal logic below is untouched from the
// "golden" version (price-in-gap filter + TP target dot) — trader
// confirmed that one actually takes trades correctly and asked to keep it
// exactly as-is. Layered on top, unchanged from the trader's own later TPT
// draft: the session cutoff, the fixed-tick stop, and the inner-band TP.
// Nothing about WHEN a signal fires was changed — only what happens AFTER
// it fires (TP/SL tracking) and one extra gate (the TPT cutoff window).
//
// MRC:
//   - R1 / S1 = Inner channel
//   - R2 / S2 = Outer channel
//
// 200 SMMA:
//   - Completely independent of MRC
//   - Uses ta.rma(close, 200)
//   - WHITE = SMMA inside MRC
//   - LIGHT BLUE = SMMA outside outer MRC
//
// QQE (entry/signal logic — unchanged from the golden version):
//   - Only prints signals while the SMMA is LIGHT BLUE, AND only the
//     signal that matches which SIDE it's outside on:
//       SMMA below the lower outer band (S2) -> long zone -> QQE Long only
//       SMMA above the upper outer band (R2) -> short zone -> QQE Short only
//   - AND the signal bar itself must have wicked into the shaded gap zone
//     between the inner and outer band (`priceInGapShort`/`priceInGapLong`)
//     — not just have the SMMA outside somewhere.
//   - AND not inside the TPT pre-close buffer window (session rule below).
//
// TP (from the trader's TPT draft):
//   LONG  -> R1 / Upper Inner Band
//   SHORT -> S1 / Lower Inner Band
//   Follows the inner band live.
//
// SL (from the trader's TPT draft):
//   Fixed N ticks from entry (input, default 100). No band-following.
//
// TPT SESSION LOGIC (from the trader's TPT draft):
//   Trades allowed during the full futures session, including overnight/
//   Asia. New trades blocked in the final `minutesBeforeClose` minutes
//   before the TPT flat deadline (default 5:00 PM New York). Any tracked
//   trade is force-cleared at the deadline itself so it can't carry
//   through the cutoff.
//
// MRC sizing matches the original fareidzulkifli MRC:
//   Inner multiplier = 1.0
//   Outer multiplier = 2.415
// ============================================================================

indicator("MRC (In/Out Bands) + 200 SMMA + QQE", overlay = true, max_lines_count = 500)


// ============================================================================
// INPUTS
// ============================================================================

grpMRC = "MRC"

mrcSource = input.source(
     hlc3,
     "Price source",
     group = grpMRC)

mrcLength = input.int(
     200,
     "Lookback period",
     minval = 1,
     group = grpMRC)

innerMult = input.float(
     1.0,
     "Inner channel size multiplier",
     minval = 0.1,
     group = grpMRC)

outerMult = input.float(
     2.415,
     "Outer channel size multiplier",
     minval = 0.1,
     group = grpMRC)

showMean = input.bool(
     false,
     "Show MRC mean line",
     group = grpMRC)

showFill = input.bool(
     true,
     "Shade between inner and outer bands",
     group = grpMRC)


// ============================================================================
// 200 SMMA SETTINGS
// ============================================================================

grpMA = "200 SMMA"

maLen = input.int(
     200,
     "SMMA length",
     minval = 1,
     group = grpMA)

showMA = input.bool(
     true,
     "Show 200 SMMA",
     group = grpMA)


// ============================================================================
// COLOR SETTINGS
// ============================================================================

grpColor = "Colors"

colInner = input.color(
     color.green,
     "Inner band color",
     group = grpColor)

colOuter = input.color(
     color.red,
     "Outer band color",
     group = grpColor)

colMean = input.color(
     #FFCD00,
     "Mean line color",
     group = grpColor)

colMA = input.color(
     color.white,
     "200 SMMA color",
     group = grpColor)

colMAOutside = input.color(
     color.rgb(100, 181, 246),
     "200 SMMA outside color",
     group = grpColor)

colTP = input.color(
     color.orange,
     "TP target color",
     group = grpColor)

colSL = input.color(
     color.fuchsia,
     "Stop level color",
     group = grpColor)


// ============================================================================
// TPT SESSION / CUTOFF SETTINGS
// ============================================================================

grpSession = "TPT Trading Hours"

// TPT flat deadline. Default = 5:00 PM New York time.
tptCloseHour = input.int(
     17,
     "TPT flat deadline hour (New York)",
     minval = 0,
     maxval = 23,
     group = grpSession)

tptCloseMinute = input.int(
     0,
     "TPT flat deadline minute",
     minval = 0,
     maxval = 59,
     group = grpSession)

// Block new trades this many minutes before TPT cutoff.
minutesBeforeClose = input.int(
     20,
     "Block new trades before TPT cutoff",
     minval = 0,
     group = grpSession)


// ============================================================================
// STOP LOSS SETTINGS
// ============================================================================

grpRisk = "Stop Loss"

slTicks = input.int(
     100,
     "Stop loss (ticks)",
     minval = 1,
     group = grpRisk)

showSL = input.bool(
     true,
     "Show stop level",
     group = grpRisk)

tickOverride = input.float(
     0.0,
     "Tick size override (0 = use symbol's own tick size)",
     minval = 0.0,
     group = grpRisk)


// ============================================================================
// QQE SETTINGS
// ============================================================================

grpQQE = "QQE"

RSI_Period = input.int(
     14,
     title = "RSI Length",
     group = grpQQE)

SF = input.int(
     5,
     title = "RSI Smoothing",
     group = grpQQE)

QQE = input.float(
     4.238,
     title = "Fast QQE Factor",
     group = grpQQE)

ThreshHold = input.int(
     10,
     title = "Thresh-hold",
     group = grpQQE)

showTP = input.bool(
     true,
     title = "Show TP target",
     group = grpQQE)


// ============================================================================
// NEW YORK TIME (TPT session)
// ============================================================================

nyHour = hour(time, "America/New_York")
nyMinute = minute(time, "America/New_York")

currentMinutes = nyHour * 60 + nyMinute
tptCloseMinutes = tptCloseHour * 60 + tptCloseMinute
minutesUntilTPTClose = tptCloseMinutes - currentMinutes


// ============================================================================
// TPT TRADING PERMISSION
// ============================================================================
//
// No 09:30-16:00 session restriction — signals are allowed NY, London,
// Asia, overnight. The only daily restriction is the TPT cutoff window.
// ============================================================================

tptCutoffWindow = minutesUntilTPTClose >= 0 and minutesUntilTPTClose <= minutesBeforeClose
allowNewTrade = not tptCutoffWindow

// Force reset the moment the TPT deadline hits, so a tracked trade can't
// visually carry through the cutoff.
tptCutoffReached = currentMinutes >= tptCloseMinutes and currentMinutes < tptCloseMinutes + 1


// ============================================================================
// SUPER SMOOTHER
// ============================================================================
//
// Same SuperSmoother calculation used by the original MRC.
// ============================================================================

f_supersmoother(src, len) =>
    a1 = math.exp(
         -math.sqrt(2) * math.pi / len)

    b1 = 2 * a1 * math.cos(
         math.sqrt(2) * math.pi / len)

    c3 = -math.pow(a1, 2)
    c2 = b1
    c1 = 1 - c2 - c3

    var float ss = na

    ss := c1 * src +
         c2 * nz(ss[1], src[1]) +
         c3 * nz(ss[2], src[2])

    ss


// ============================================================================
// MRC CALCULATION
// ============================================================================

// MRC mean
meanline = f_supersmoother(
     mrcSource,
     mrcLength)

// MRC range
meanrange = f_supersmoother(
     ta.tr,
     mrcLength)


// ============================================================================
// ORIGINAL MRC MULTIPLIERS
// ============================================================================

multInner = math.pi * innerMult
multOuter = math.pi * outerMult


// ============================================================================
// MRC BANDS
// ============================================================================

// Inner channel
upperInner = meanline + (meanrange * multInner)
lowerInner = meanline - (meanrange * multInner)

// Outer channel
upperOuter = meanline + (meanrange * multOuter)
lowerOuter = meanline - (meanrange * multOuter)


// ============================================================================
// 200 SMMA
// ============================================================================
//
// SMMA = TradingView's RMA implementation.
// Completely independent from MRC.
// ============================================================================

maVal = ta.rma(close, maLen)


// ============================================================================
// SMMA / MRC RELATIONSHIP
// ============================================================================
//
// LIGHT BLUE when SMMA is OUTSIDE the outer MRC (either side).
// WHITE when SMMA is INSIDE the outer MRC.
//
// maBelowOuter / maAboveOuter split that "outside" state by SIDE, so the
// QQE filter below can tell a long-valid zone from a short-valid zone
// instead of treating both sides of "outside" as the same thing.
// ============================================================================

maBelowOuter = maVal < lowerOuter   // valid LONG zone
maAboveOuter = maVal > upperOuter   // valid SHORT zone
maOutsideMRC = maBelowOuter or maAboveOuter

maPlotColor = maOutsideMRC
     ? colMAOutside
     : colMA


// ============================================================================
// MRC PLOTS
// ============================================================================

pInnU = plot(
     upperInner,
     title = "MRC R1 (Inner)",
     color = color.new(colInner, 30),
     linewidth = 1)

pInnL = plot(
     lowerInner,
     title = "MRC S1 (Inner)",
     color = color.new(colInner, 30),
     linewidth = 1)

pOutU = plot(
     upperOuter,
     title = "MRC R2 (Outer)",
     color = color.new(colOuter, 20),
     linewidth = 1)

pOutL = plot(
     lowerOuter,
     title = "MRC S2 (Outer)",
     color = color.new(colOuter, 20),
     linewidth = 1)


// ============================================================================
// MRC SHADING
// ============================================================================

fill(
     pInnU,
     pOutU,
     color = showFill
         ? color.new(colOuter, 88)
         : na,
     title = "Upper MRC Shade")

fill(
     pInnL,
     pOutL,
     color = showFill
         ? color.new(colInner, 88)
         : na,
     title = "Lower MRC Shade")


// ============================================================================
// MRC MEAN
// ============================================================================

plot(
     showMean ? meanline : na,
     title = "MRC Mean",
     color = color.new(colMean, 0),
     linewidth = 2)


// ============================================================================
// 200 SMMA
// ============================================================================

plot(
     showMA ? maVal : na,
     title = "200 SMMA",
     color = color.new(maPlotColor, 0),
     linewidth = 2)


// ============================================================================
// QQE CALCULATION
// ============================================================================

src = close

Wilders_Period = RSI_Period * 2 - 1

Rsi = ta.rsi(src, RSI_Period)

RsiMa = ta.ema(Rsi, SF)

AtrRsi = math.abs(RsiMa[1] - RsiMa)

MaAtrRsi = ta.ema(
     AtrRsi,
     Wilders_Period)

dar = ta.ema(
     MaAtrRsi,
     Wilders_Period) * QQE


// ============================================================================
// QQE BANDS
// ============================================================================

var float longband = 0.0
var float shortband = 0.0
var int trend = 0

DeltaFastAtrRsi = dar
RSIndex = RsiMa

newshortband = RSIndex + DeltaFastAtrRsi
newlongband = RSIndex - DeltaFastAtrRsi

longband := RSIndex[1] > longband[1] and RSIndex > longband[1] ?
     math.max(longband[1], newlongband) :
     newlongband

shortband := RSIndex[1] < shortband[1] and RSIndex < shortband[1] ?
     math.min(shortband[1], newshortband) :
     newshortband


// ============================================================================
// QQE TREND
// ============================================================================

crossLongBand = ta.cross(longband[1], RSIndex)

crossShortBand = ta.cross(RSIndex, shortband[1])

trend := crossShortBand ?
     1 :
     crossLongBand ?
     -1 :
     nz(trend[1], 1)

FastAtrRsiTL = trend == 1 ?
     longband :
     shortband


// ============================================================================
// FIND ALL QQE CROSSES
// ============================================================================

var int QQExlong = 0
var int QQExshort = 0

QQExlong := FastAtrRsiTL < RSIndex ?
     QQExlong + 1 :
     0

QQExshort := FastAtrRsiTL > RSIndex ?
     QQExshort + 1 :
     0


// ============================================================================
// ORIGINAL QQE CONDITIONS
// ============================================================================

qqeLongRaw = QQExlong == 1 ?
     FastAtrRsiTL[1] - 50 :
     na

qqeShortRaw = QQExshort == 1 ?
     FastAtrRsiTL[1] - 50 :
     na


// ============================================================================
// PRICE-IN-GAP FILTER (unchanged from the golden version)
// ============================================================================

priceInGapShort = high >= upperInner   // candle reached at least the inner band on the short side
priceInGapLong  = low  <= lowerInner   // candle reached at least the inner band on the long side


// ============================================================================
// QQE FILTER — the entry/signal logic itself, UNCHANGED from the golden
// version. The only addition is `allowNewTrade` (the TPT session rule).
// ============================================================================

qqeLong = (maBelowOuter and priceInGapLong and allowNewTrade) ?
     qqeLongRaw :
     na

qqeShort = (maAboveOuter and priceInGapShort and allowNewTrade) ?
     qqeShortRaw :
     na


// ============================================================================
// TP + STOP TRACKING (from the trader's TPT draft)
// ============================================================================
//
// LONG:  TP = R1 / Upper Inner, SL = slTicks below entry
// SHORT: TP = S1 / Lower Inner, SL = slTicks above entry
// ============================================================================

tick = tickOverride > 0 ? tickOverride : syminfo.mintick

var int qqeDir = 0
var float slLevel = na
var float entryPriceTracked = na

// Force flat / clear at TPT deadline
if tptCutoffReached
    qqeDir := 0
    slLevel := na
    entryPriceTracked := na

// Long entry
if not na(qqeLong) and not tptCutoffReached
    qqeDir := 1
    entryPriceTracked := close
    slLevel := entryPriceTracked - slTicks * tick

// Short entry
if not na(qqeShort) and not tptCutoffReached
    qqeDir := -1
    entryPriceTracked := close
    slLevel := entryPriceTracked + slTicks * tick

// Long TP / SL
if qqeDir == 1
    if high >= upperInner          // TP = R1
        qqeDir := 0
        slLevel := na
        entryPriceTracked := na
    else if low <= slLevel         // SL
        qqeDir := 0
        slLevel := na
        entryPriceTracked := na

// Short TP / SL
if qqeDir == -1
    if low <= lowerInner           // TP = S1
        qqeDir := 0
        slLevel := na
        entryPriceTracked := na
    else if high >= slLevel        // SL
        qqeDir := 0
        slLevel := na
        entryPriceTracked := na

// TP follows the inner band live
tpLevel = qqeDir == 1 ?
     upperInner :
     qqeDir == -1 ?
     lowerInner :
     na

slPlot = qqeDir != 0 ? slLevel : na


// ============================================================================
// QQE PLOTS
// ============================================================================

plotshape(
     not na(qqeLong),
     title = "QQE Long",
     text = "Long",
     textcolor = color.white,
     style = shape.labelup,
     location = location.belowbar,
     color = color.green,
     size = size.tiny)

plotshape(
     not na(qqeShort),
     title = "QQE Short",
     text = "Short",
     textcolor = color.white,
     style = shape.labeldown,
     location = location.abovebar,
     color = color.red,
     size = size.tiny)


// ============================================================================
// TP TARGET
// ============================================================================

plot(
     showTP ? tpLevel : na,
     title = "TP Target - Inner Band",
     style = plot.style_circles,
     color = color.new(colTP, 0),
     linewidth = 3)


// ============================================================================
// STOP LEVEL
// ============================================================================

plot(
     showSL ? slPlot : na,
     title = "Stop Level",
     style = plot.style_circles,
     color = color.new(colSL, 0),
     linewidth = 3)


// ============================================================================
// ALERTS
// ============================================================================

alertcondition(
     not na(qqeLong),
     title = "QQE Long",
     message = "QQE Long")

alertcondition(
     not na(qqeShort),
     title = "QQE Short",
     message = "QQE Short")
