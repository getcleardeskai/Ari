//@version=6

// ============================================================================
// MRC (In/Out Bands) + 200 SMMA + QQE
//
// MRC:
//   - R1 / S1 = Inner channel
//   - R2 / S2 = Outer channel
//
// 200 SMMA:
//   - Completely independent of MRC
//   - Uses ta.rma(close, 200)
//   - WHITE = SMMA inside MRC
//   - LIGHT BLUE = SMMA outside outer MRC
//
// QQE:
//   - Only prints signals while the SMMA is LIGHT BLUE, AND only the
//     signal that matches which SIDE it's outside on:
//       SMMA below the lower outer band (S2) -> long zone -> QQE Long only
//       SMMA above the upper outer band (R2) -> short zone -> QQE Short only
//   - 2026-08-20 FIX: the first version gated both qqeLong and qqeShort on
//     the same direction-agnostic `maOutsideMRC` (true if the SMMA cleared
//     EITHER band, regardless of which side) — so a QQE Long could still
//     print while the SMMA was pinned above the upper band, i.e. inside
//     short-only territory, and vice versa. Caught live: a "Long" label
//     printing well up in a short zone. Split into `maBelowOuter` (valid
//     long zone) and `maAboveOuter` (valid short zone) so each signal only
//     prints in the zone that actually matches it.
//   - 2026-08-20, later: SMMA-side gating alone still let through signals
//     that fired while price itself was nowhere near the band — the SMMA
//     is slow (200-bar), so it can sit outside the outer band for a long
//     stretch while price bounces around well inside the channel the whole
//     time, and any QQE cross during that stretch printed. Added a second,
//     PRICE-based condition: the signal bar itself must have wicked into
//     the shaded gap zone between the inner and outer band (`priceInGapShort`
//     / `priceInGapLong`) — not just have the SMMA outside somewhere. Only
//     the shorts/longs that actually formed with price inside that gap
//     print now.
//   - Original QQE logic converted to Pine v6
//
// TP TARGET DOT:
//   - After a signal prints, a small dot tracks a target band every bar,
//     moving with it, until price actually touches it — then it
//     disappears until the next signal. Purely visual, no strategy/entries.
//   - 2026-08-20: per trader request, TP always tracks the BOTTOM outer
//     band (S2), for either direction — previously it was the opposite
//     band (top for a long, bottom for a short); this was a deliberate
//     change, not a bugfix.
//
// STOP LEVEL:
//   - On the SAME side as entry — R2 for a short, S2 for a long. Follows
//     that band live every bar UNTIL price comes within `slBufferTicks`
//     (default 25) of it — at that point it LOCKS: a fixed `slFixedTicks`
//     (default 100) level is computed once and held for the rest of the
//     trade, even if price later drifts back away from the band. 2026-08-20
//     FIX: the fixed-tick fallback was being recomputed off the live
//     `close` every bar, so it was never actually "fixed" — it drifted
//     with price like a very tight trail. Now it locks in once and stays
//     put, per trader request ("i want the stoploss to be fixed if its a
//     tick stoploss").
//   - Clears the same way the TP dot does: on a target hit, a stop hit, or
//     a fresh signal in either direction taking over the tracking.
//
// OPACITY (2026-08-20 FIX): every plot used to pass a hardcoded
// transparency number straight into color.new(), discarding whatever alpha
// the color picker was set to — changing "opacity" visibly did nothing.
// Every element now has its own explicit opacity %  input, actually wired
// into its plot.
//
// QQE Long/Short label colors are now inputs (`colQQELong`/`colQQEShort`)
// instead of hardcoded green/red.
//
// MRC sizing matches the original fareidzulkifli MRC:
//   Inner multiplier = 1.0
//   Outer multiplier = 2.415
// ============================================================================

indicator("MRC (In/Out Bands) + 200 SMMA + QQE", overlay = true, max_lines_count = 500)


// ============================================================================
// INPUTS
// ============================================================================

grpMRC = "MRC"

mrcSource = input.source(
     hlc3,
     "Price source",
     group = grpMRC)

mrcLength = input.int(
     200,
     "Lookback period",
     minval = 1,
     group = grpMRC)

innerMult = input.float(
     1.0,
     "Inner channel size multiplier",
     minval = 0.1,
     group = grpMRC)

outerMult = input.float(
     2.415,
     "Outer channel size multiplier",
     minval = 0.1,
     group = grpMRC)

showMean = input.bool(
     false,
     "Show MRC mean line",
     group = grpMRC)

showFill = input.bool(
     true,
     "Shade between inner and outer bands",
     group = grpMRC)


// ============================================================================
// 200 SMMA SETTINGS
// ============================================================================

grpMA = "200 SMMA"

maLen = input.int(
     200,
     "SMMA length",
     minval = 1,
     group = grpMA)

showMA = input.bool(
     true,
     "Show 200 SMMA",
     group = grpMA)


// ============================================================================
// COLOR SETTINGS
// ============================================================================

grpColor = "Colors"

// Opacity here is a plain 0-100 "% opaque" scale (100 = fully solid), the
// opposite of Pine's own `transparency` argument to color.new() (0 = fully
// solid) — converted with `100 - opacityPct` everywhere it's used below.
// 2026-08-20 FIX: every plot used to pass a hardcoded transparency number
// straight into color.new(), which silently discarded whatever alpha the
// color picker itself was set to — changing "opacity" in the picker did
// nothing. Now each element has its own explicit opacity input that's
// actually wired into its plot.

colInner = input.color(
     color.green,
     "Inner band color",
     group = grpColor)

innerOpacity = input.int(
     70,
     "Inner band opacity %",
     minval = 0,
     maxval = 100,
     group = grpColor)

colOuter = input.color(
     color.red,
     "Outer band color",
     group = grpColor)

outerOpacity = input.int(
     80,
     "Outer band opacity %",
     minval = 0,
     maxval = 100,
     group = grpColor)

fillOpacity = input.int(
     12,
     "Band shade opacity %",
     minval = 0,
     maxval = 100,
     group = grpColor)

colMean = input.color(
     #FFCD00,
     "Mean line color",
     group = grpColor)

meanOpacity = input.int(
     100,
     "Mean line opacity %",
     minval = 0,
     maxval = 100,
     group = grpColor)

colMA = input.color(
     color.white,
     "200 SMMA color",
     group = grpColor)

colMAOutside = input.color(
     color.rgb(100, 181, 246),
     "200 SMMA outside color",
     group = grpColor)

maOpacity = input.int(
     100,
     "200 SMMA opacity %",
     minval = 0,
     maxval = 100,
     group = grpColor)

colQQELong = input.color(
     color.green,
     "QQE Long color",
     group = grpColor)

colQQEShort = input.color(
     color.red,
     "QQE Short color",
     group = grpColor)

qqeOpacity = input.int(
     100,
     "QQE label opacity %",
     minval = 0,
     maxval = 100,
     group = grpColor)

colTP = input.color(
     color.orange,
     "TP target dot color",
     group = grpColor)

tpOpacity = input.int(
     100,
     "TP target dot opacity %",
     minval = 0,
     maxval = 100,
     group = grpColor)

colSL = input.color(
     color.fuchsia,
     "Stop level color",
     group = grpColor)

slOpacity = input.int(
     100,
     "Stop level opacity %",
     minval = 0,
     maxval = 100,
     group = grpColor)


// ============================================================================
// FILTER SETTINGS (customizability — turn either gate off independently to
// compare, or change which band the price-in-gap check uses)
// ============================================================================

grpFilters = "Filters"

enableMASideFilter = input.bool(
     true,
     "Require SMMA on the matching side (outer band)",
     group = grpFilters)

enablePriceGapFilter = input.bool(
     true,
     "Require price to have wicked into the gap zone",
     group = grpFilters)

gapFilterBand = input.string(
     "Inner",
     "Price-in-gap check band",
     options = ["Inner", "Outer"],
     group = grpFilters)


// ============================================================================
// STOP LOSS SETTINGS
// ============================================================================

grpRisk = "Stop Loss"

showSL = input.bool(
     true,
     "Show stop level",
     group = grpRisk)

slBufferTicks = input.int(
     25,
     "Use fixed stop if entry price is within this many ticks of R2/S2",
     minval = 0,
     group = grpRisk)

slFixedTicks = input.int(
     100,
     "Fixed stop (ticks) when within the buffer above",
     minval = 1,
     group = grpRisk)

tickOverride = input.float(
     0.0,
     "Tick size override (0 = use symbol's own tick size)",
     minval = 0.0,
     group = grpRisk)


// ============================================================================
// QQE SETTINGS
// ============================================================================

grpQQE = "QQE"

RSI_Period = input.int(
     14,
     title = "RSI Length",
     group = grpQQE)

SF = input.int(
     5,
     title = "RSI Smoothing",
     group = grpQQE)

QQE = input.float(
     4.238,
     title = "Fast QQE Factor",
     group = grpQQE)

ThreshHold = input.int(
     10,
     title = "Thresh-hold",
     group = grpQQE)

showTP = input.bool(
     true,
     title = "Show TP target dot",
     group = grpQQE)


// ============================================================================
// SUPER SMOOTHER
// ============================================================================
//
// Same SuperSmoother calculation used by the original MRC.
// ============================================================================

f_supersmoother(src, len) =>
    a1 = math.exp(
         -math.sqrt(2) * math.pi / len)

    b1 = 2 * a1 * math.cos(
         math.sqrt(2) * math.pi / len)

    c3 = -math.pow(a1, 2)
    c2 = b1
    c1 = 1 - c2 - c3

    var float ss = na

    ss := c1 * src +
         c2 * nz(ss[1], src[1]) +
         c3 * nz(ss[2], src[2])

    ss


// ============================================================================
// MRC CALCULATION
// ============================================================================

// MRC mean
meanline = f_supersmoother(
     mrcSource,
     mrcLength)

// MRC range
meanrange = f_supersmoother(
     ta.tr,
     mrcLength)


// ============================================================================
// ORIGINAL MRC MULTIPLIERS
// ============================================================================

multInner = math.pi * innerMult
multOuter = math.pi * outerMult


// ============================================================================
// MRC BANDS
// ============================================================================

// Inner channel
upperInner = meanline + (meanrange * multInner)
lowerInner = meanline - (meanrange * multInner)

// Outer channel
upperOuter = meanline + (meanrange * multOuter)
lowerOuter = meanline - (meanrange * multOuter)


// ============================================================================
// 200 SMMA
// ============================================================================
//
// SMMA = TradingView's RMA implementation.
// Completely independent from MRC.
// ============================================================================

maVal = ta.rma(close, maLen)


// ============================================================================
// SMMA / MRC RELATIONSHIP
// ============================================================================
//
// LIGHT BLUE when SMMA is OUTSIDE the outer MRC (either side).
//
// WHITE when SMMA is INSIDE the outer MRC.
//
// maBelowOuter / maAboveOuter split that "outside" state by SIDE, so the
// QQE filter below can tell a long-valid zone from a short-valid zone
// instead of treating both sides of "outside" as the same thing.
// ============================================================================

maBelowOuter = maVal < lowerOuter   // valid LONG zone
maAboveOuter = maVal > upperOuter   // valid SHORT zone
maOutsideMRC = maBelowOuter or maAboveOuter

maPlotColor = maOutsideMRC
     ? colMAOutside
     : colMA


// ============================================================================
// MRC PLOTS
// ============================================================================

pInnU = plot(
     upperInner,
     title = "MRC R1 (Inner)",
     color = color.new(colInner, 100 - innerOpacity),
     linewidth = 1)

pInnL = plot(
     lowerInner,
     title = "MRC S1 (Inner)",
     color = color.new(colInner, 100 - innerOpacity),
     linewidth = 1)

pOutU = plot(
     upperOuter,
     title = "MRC R2 (Outer)",
     color = color.new(colOuter, 100 - outerOpacity),
     linewidth = 1)

pOutL = plot(
     lowerOuter,
     title = "MRC S2 (Outer)",
     color = color.new(colOuter, 100 - outerOpacity),
     linewidth = 1)


// ============================================================================
// MRC SHADING
// ============================================================================

fill(
     pInnU,
     pOutU,
     color = showFill
         ? color.new(colOuter, 100 - fillOpacity)
         : na,
     title = "Upper MRC Shade")

fill(
     pInnL,
     pOutL,
     color = showFill
         ? color.new(colInner, 100 - fillOpacity)
         : na,
     title = "Lower MRC Shade")


// ============================================================================
// MRC MEAN
// ============================================================================

plot(
     showMean ? meanline : na,
     title = "MRC Mean",
     color = color.new(colMean, 100 - meanOpacity),
     linewidth = 2)


// ============================================================================
// 200 SMMA
// ============================================================================

plot(
     showMA ? maVal : na,
     title = "200 SMMA",
     color = color.new(maPlotColor, 100 - maOpacity),
     linewidth = 2)


// ============================================================================
// QQE CALCULATION
// ============================================================================

src = close

Wilders_Period = RSI_Period * 2 - 1

Rsi = ta.rsi(src, RSI_Period)

RsiMa = ta.ema(Rsi, SF)

AtrRsi = math.abs(RsiMa[1] - RsiMa)

MaAtrRsi = ta.ema(
     AtrRsi,
     Wilders_Period)

dar = ta.ema(
     MaAtrRsi,
     Wilders_Period) * QQE


// ============================================================================
// QQE BANDS
// ============================================================================

var float longband = 0.0
var float shortband = 0.0
var int trend = 0

DeltaFastAtrRsi = dar
RSIndex = RsiMa

newshortband = RSIndex + DeltaFastAtrRsi
newlongband = RSIndex - DeltaFastAtrRsi

longband := RSIndex[1] > longband[1] and RSIndex > longband[1] ?
     math.max(longband[1], newlongband) :
     newlongband

shortband := RSIndex[1] < shortband[1] and RSIndex < shortband[1] ?
     math.min(shortband[1], newshortband) :
     newshortband


// ============================================================================
// QQE TREND
// ============================================================================

crossLongBand = ta.cross(longband[1], RSIndex)

crossShortBand = ta.cross(RSIndex, shortband[1])

trend := crossShortBand ?
     1 :
     crossLongBand ?
     -1 :
     nz(trend[1], 1)

FastAtrRsiTL = trend == 1 ?
     longband :
     shortband


// ============================================================================
// FIND ALL QQE CROSSES
// ============================================================================

var int QQExlong = 0
var int QQExshort = 0

QQExlong := FastAtrRsiTL < RSIndex ?
     QQExlong + 1 :
     0

QQExshort := FastAtrRsiTL > RSIndex ?
     QQExshort + 1 :
     0


// ============================================================================
// ORIGINAL QQE CONDITIONS
// ============================================================================

qqeLongRaw = QQExlong == 1 ?
     FastAtrRsiTL[1] - 50 :
     na

qqeShortRaw = QQExshort == 1 ?
     FastAtrRsiTL[1] - 50 :
     na


// ============================================================================
// PRICE-IN-GAP FILTER
// ============================================================================
//
// The SMMA-side gate alone only tells you the SMMA is somewhere beyond the
// outer band — it says nothing about where PRICE actually is. Since the
// SMMA is a slow 200-bar average, it can sit outside the outer band for a
// long stretch while price spends most of that stretch bouncing around
// well inside the channel, nowhere near either band. Any QQE cross during
// that whole stretch used to print.
//
// priceInGapShort / priceInGapLong require the SIGNAL BAR ITSELF to have
// wicked into the shaded gap zone between the inner and outer band (same
// zone the "MRC SHADING" fill below draws) — not just have the SMMA
// outside somewhere. Only signals that actually formed with price up
// against (or past) that zone count now.
//
// `gapFilterBand` picks which line counts as "reached the gap": Inner
// (R1/S1, the near edge of the shaded zone — the default) or Outer (R2/S2,
// requiring price to have gone all the way through to the far edge).
// ============================================================================

gapCheckUpper = gapFilterBand == "Inner" ? upperInner : upperOuter
gapCheckLower = gapFilterBand == "Inner" ? lowerInner : lowerOuter

priceInGapShort = high >= gapCheckUpper   // candle reached the chosen band on the short side
priceInGapLong  = low  <= gapCheckLower   // candle reached the chosen band on the long side


// ============================================================================
// QQE FILTER
// ============================================================================
//
// THIS IS THE IMPORTANT PART:
//
// QQE Long only prints while the SMMA is below the lower outer band
// (maBelowOuter) AND price itself wicked into the gap zone on this bar
// (priceInGapLong) — the zone we actually look for longs in.
//
// QQE Short only prints while the SMMA is above the upper outer band
// (maAboveOuter) AND price itself wicked into the gap zone on this bar
// (priceInGapShort) — the zone we actually look for shorts in.
//
// 2026-08-20 FIX: previously both were gated on the same direction-
// agnostic `maOutsideMRC`, so a Long could print while the SMMA was
// outside on the SHORT side (and vice versa) — any "outside" counted for
// both signals. Now each signal only fires in the zone that matches it.
//
// 2026-08-20, later: added the price-in-gap condition above so a signal
// also has to have price actually up against the band, not just the SMMA
// sitting outside somewhere far from where price currently is.
//
// Both gates can be independently switched off via `enableMASideFilter` /
// `enablePriceGapFilter` for testing/comparison — a disabled gate just
// evaluates as always-true, so turning both off falls back to raw QQE.
// ============================================================================

maLongOk  = not enableMASideFilter or maBelowOuter
maShortOk = not enableMASideFilter or maAboveOuter
gapLongOk  = not enablePriceGapFilter or priceInGapLong
gapShortOk = not enablePriceGapFilter or priceInGapShort

qqeLong = (maLongOk and gapLongOk) ?
     qqeLongRaw :
     na

qqeShort = (maShortOk and gapShortOk) ?
     qqeShortRaw :
     na


// ============================================================================
// TP TARGET + STOP TRACKING
// ============================================================================
//
// After a valid signal, track the target — per trader request 2026-08-20,
// TP is always the BOTTOM outer band (S2), for either direction (was
// previously the opposite band, i.e. top for a long / bottom for a short —
// changed on request, not a bug). It moves with the band every bar until
// price actually touches it, then goes away until the next signal. A
// fresh signal (either direction) always takes over the tracking, even
// mid-track.
//
// The stop is on the SAME side as entry — S2 for a long, R2 for a short —
// and follows that band live every bar (like the TP dot) UNTIL price comes
// within `slBufferTicks` of it. At that point, per trader request
// 2026-08-20, the stop LOCKS: it's no longer "fixed" if it's still being
// recomputed off the live `close` every bar (that's just a very tight
// trail, not fixed) — so the first bar the buffer condition is met, the
// fixed-tick level is calculated ONCE and held (`slIsFixed` / `slFixedLvl`)
// for the rest of the trade, even if price later drifts back away from the
// band. Resets on every new signal and on a target/stop hit.
// ============================================================================

tick = tickOverride > 0 ? tickOverride : syminfo.mintick

var int   qqeDir     = 0     // 1 = tracking a long, -1 = a short, 0 = none
var bool  slIsFixed  = false // true once the tick-stop fallback has locked in for this trade
var float slFixedLvl = na    // the frozen fixed-tick stop price, once locked

if not na(qqeLong)
    qqeDir     := 1
    slIsFixed  := false
    slFixedLvl := na
if not na(qqeShort)
    qqeDir     := -1
    slIsFixed  := false
    slFixedLvl := na

// Lock the fixed-tick stop the first bar price comes within the buffer of
// the entry-side band — once locked it stays put, it does not keep
// recomputing off `close` (that would make it drift with price, not fixed).
if qqeDir == 1 and not slIsFixed and math.abs(close - lowerOuter) <= slBufferTicks * tick
    slIsFixed  := true
    slFixedLvl := close - slFixedTicks * tick

if qqeDir == -1 and not slIsFixed and math.abs(upperOuter - close) <= slBufferTicks * tick
    slIsFixed  := true
    slFixedLvl := close + slFixedTicks * tick

slLevel = qqeDir == 1 ?
     (slIsFixed ? slFixedLvl : lowerOuter) :
     qqeDir == -1 ?
     (slIsFixed ? slFixedLvl : upperOuter) :
     na

if qqeDir == 1
    if high >= upperOuter
        qqeDir     := 0    // target hit
        slIsFixed  := false
        slFixedLvl := na
    else if low <= slLevel
        qqeDir     := 0    // stopped out
        slIsFixed  := false
        slFixedLvl := na

if qqeDir == -1
    if low <= lowerOuter
        qqeDir     := 0    // target hit
        slIsFixed  := false
        slFixedLvl := na
    else if high >= slLevel
        qqeDir     := 0    // stopped out
        slIsFixed  := false
        slFixedLvl := na

tpLevel = qqeDir != 0 ? lowerOuter : na   // always the bottom line, per request

slPlot = qqeDir != 0 ? slLevel : na


// ============================================================================
// QQE PLOTS
// ============================================================================

plotshape(
     not na(qqeLong),
     title = "QQE Long",
     text = "Long",
     textcolor = color.white,
     style = shape.labelup,
     location = location.belowbar,
     color = color.new(colQQELong, 100 - qqeOpacity),
     size = size.tiny)

plotshape(
     not na(qqeShort),
     title = "QQE Short",
     text = "Short",
     textcolor = color.white,
     style = shape.labeldown,
     location = location.abovebar,
     color = color.new(colQQEShort, 100 - qqeOpacity),
     size = size.tiny)


// ============================================================================
// TP TARGET DOT
// ============================================================================

plot(
     showTP ? tpLevel : na,
     title = "TP Target",
     style = plot.style_circles,
     color = color.new(colTP, 100 - tpOpacity),
     linewidth = 3)


// ============================================================================
// STOP LEVEL
// ============================================================================

plot(
     showSL ? slPlot : na,
     title = "Stop Level",
     style = plot.style_circles,
     color = color.new(colSL, 100 - slOpacity),
     linewidth = 3)


// ============================================================================
// ALERTS
// ============================================================================

alertcondition(
     not na(qqeLong),
     title = "QQE Long",
     message = "QQE Long")

alertcondition(
     not na(qqeShort),
     title = "QQE Short",
     message = "QQE Short")
